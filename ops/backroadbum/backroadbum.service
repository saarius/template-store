[Unit]
Description=Backroad Bum EmDash demo store
After=network.target

[Service]
Type=simple
User=agent
Group=agent
WorkingDirectory=/var/lib/trialrun/workspace/repos/template-store
Environment=NODE_ENV=production
EnvironmentFile=/etc/backroadbum/emdash.env
Environment=HOST=127.0.0.1
Environment=PORT=4321
Environment=EMDASH_SITE_URL=https://backroadbum.com
Environment=BACKROADBUM_MERCHANT_PROFILE=1
Environment=BACKROADBUM_HOSTED_REGISTRY=1
Environment=BACKROADBUM_CHECKOUT_ENABLED=1
Environment=DINKUS_TEMPLATE_DB_URL=file:/var/lib/backroadbum/content.db
Environment=DINKUS_TEMPLATE_UPLOADS_DIR=/var/lib/backroadbum/uploads
Environment=PATH=/opt/node/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/node/bin/node /var/lib/trialrun/workspace/ops/start-store.mjs /var/lib/backroadbum/current/server/entry.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
# Main closes HTTP before forwarding SIGTERM to the runner. Children remain
# available for admitted requests; systemd kills the whole group at the bound.
KillSignal=SIGINT
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
