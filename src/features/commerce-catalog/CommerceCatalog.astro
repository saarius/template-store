---
import { AddToCart } from "../guest-cart/ui.ts";
import { catalogCardAvailability, type PublicCommerceProduct } from "./index.js";
import ProductMedia from "./ProductMedia.astro";
import { demoPlaceholderImage } from "../playground/demo-products.js";
import { catalogNoticeText } from "../store-shell/checkout-copy.js";
interface Props {
  products: PublicCommerceProduct[];
  unavailable?: boolean;
  /** Commerce item id -> published EmDash product page path. */
  productPaths?: ReadonlyMap<string, string>;
  /** Installed checkout admission; the footnote stays quiet when checkout works. */
  checkoutAvailable?: boolean;
  heading?: string;
  emptyMessage?: string;
  /** Fit inside an existing page container rather than adding another set of gutters. */
  contained?: boolean;
}
const { products, unavailable = false, productPaths = new Map(), checkoutAvailable = false,
  heading = "Shop", emptyMessage = "No products are listed yet.", contained = false } = Astro.props;
const notice = catalogNoticeText({ unavailable, productCount: products.length, checkoutAvailable });
---
<section class:list={["shop-catalog", { "shop-catalog--contained": contained }]} aria-labelledby="commerce-catalog" data-commerce-catalog>
  <header class="shop-catalog__heading"><h2 id="commerce-catalog">{heading}</h2>{!unavailable && products.length > 0 && <p>{products.length} {products.length === 1 ? 'good' : 'goods'} for the road</p>}</header>
  {unavailable ? <p role="alert">The product catalog is temporarily unavailable. Please try again shortly.</p> : products.length === 0 ? <p data-commerce-empty>{emptyMessage}</p> : <div class="shop-grid">
    {products.map(product => {
      const href = productPaths.get(product.id);
      const availability = catalogCardAvailability(product);
      const body = <>
      <ProductMedia image={product.image} productId={product.id} fallbackSrc={demoPlaceholderImage(product.sku, href?.split("/").pop())} fallbackAlt={`${product.name} placeholder image`} />
      <div class="shop-card__body">
        <h3>{product.name}</h3>
        <div class="shop-card__facts">
          <p class="price">{product.price.saleText ? <><s data-regular-price>{product.price.regularText}</s><strong data-sale-price>{product.price.saleText}</strong></> : <strong data-regular-price>{product.price.regularText}</strong>}</p>
          <p class="availability" data-commerce-availability={availability.status}>{availability.label}</p>
        </div>
        {!href && <AddToCart product={product} />}
      </div></>;
      // A linked card is one whole link; buying happens on the product page.
      return href
        ? <a class="shop-card shop-card--link" href={href} data-commerce-product={product.id} data-product-link>{body}</a>
        : <article class="shop-card" data-commerce-product={product.id}>{body}</article>;
    })}
  </div>}
  {notice && <p class="notice">{notice}</p>}
</section>
<style>
  .shop-catalog{width:min(80rem,calc(100% - 2.5rem));margin:var(--space-7) auto var(--space-9)}
  .shop-catalog.shop-catalog--contained{width:100%;margin:var(--space-6) 0 var(--space-8)}
  .shop-catalog__heading{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:var(--space-2) var(--space-5);margin-bottom:var(--space-5)}
  .shop-catalog h2{font-size:var(--text-3xl);line-height:1.2;letter-spacing:-.025em;margin:0}
  .shop-catalog__heading p{font-size:var(--text-sm);color:var(--store-muted);margin:0;font-variant-numeric:tabular-nums}
  .shop-grid{display:grid;grid-template-columns:1fr;gap:var(--space-7) var(--space-5)}
  .shop-card{display:flex;min-width:0;overflow:hidden;overflow-wrap:anywhere;flex-direction:column;border:1px solid var(--color-border);border-radius:var(--radius-card);background:var(--store-surface);transition:border-color .18s ease,background .18s ease}
  .shop-card--link{text-decoration:none;color:inherit}
  .shop-card--link:hover{border-color:var(--store-ink-border);background:var(--store-surface-subtle)}
  .shop-card--link:hover h3,.shop-card--link:focus-visible h3{text-decoration:underline;text-decoration-color:var(--store-accent);text-underline-offset:.2em}
  .shop-card--link:active{border-color:var(--store-accent)}
  .shop-card--link:focus-visible{outline:3px solid var(--store-focus-ring);outline-offset:4px}
  .shop-card__body{display:flex;flex:1;flex-direction:column;padding:var(--space-5)}
  .shop-card h3{font-size:var(--text-xl);font-weight:500;line-height:1.25;margin:0 0 var(--space-3)}
  .shop-card__facts{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:var(--space-2) var(--space-4);margin-top:auto}
  .shop-card .price{display:flex;gap:var(--space-2);flex-wrap:wrap;margin:0;font-family:var(--font-sans);font-size:1rem}
  .shop-card .availability{margin:0;color:var(--store-muted);font-size:var(--text-sm)}
  .shop-card :global(.guest-cart-add){margin-top:auto;padding-top:var(--space-4)}
  s,.notice{color:var(--store-muted)}.notice{line-height:1.618}
  @media(min-width:38rem){.shop-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(min-width:64rem){.shop-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
</style>
