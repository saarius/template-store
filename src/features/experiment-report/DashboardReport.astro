---
import { readFile } from 'node:fs/promises';
import BackroadPage from '../store-shell/BackroadPage.astro';
import { uploadRecoverySummary } from './upload-recovery';
import { observationTime, parseTelemetry, telemetryIsStale, trafficIsStale, type DashboardTelemetry } from './telemetry';
import DashboardPulse from './DashboardPulse.astro';
import DashboardReviews from './DashboardReviews.astro';
import DashboardShowcase from './DashboardShowcase.astro';
import DashboardEvidence from './DashboardEvidence.astro';
import './dashboard.css';
interface Props { view?: 'overview' | 'history' | 'contributions' }
const { view = 'overview' } = Astro.props;
const overview = view === 'overview';
const title = overview ? 'The experiment' : view === 'history' ? 'Build history' : 'DinkusKit contributions';
let status: DashboardTelemetry | null = null;
if (overview) {
  try { status = parseTelemetry(JSON.parse(await readFile('/var/lib/backroadbum/telemetry.json','utf8'))); } catch {}
}
const show = (value: unknown, suffix = '') => value === null || value === undefined ? 'Unavailable' : `${value}${suffix}`;
const stale = telemetryIsStale(status);
const trafficReady = !stale && !trafficIsStale(status?.traffic);
const activity = status?.activity?.schema === 'backroadbum.activity/v1' ? status.activity : null;
const checkoutHistory = status?.checkoutHistory?.schema === 'backroadbum.checkout-observations/v1' ? status.checkoutHistory : null;
const checkoutProbe = status?.checkoutProbe?.schema === 'backroadbum.checkout-probe/v1' ? status.checkoutProbe : null;
const probeLabels = new Map<string, string>([
  ['ready-advisory', 'Test readiness supported'], ['admission-closed', 'Admission deliberately closed'],
  ['readiness-unavailable', 'Readiness advisory unavailable'], ['timeout', 'Probe timed out'],
  ['network-error', 'Network request failed'], ['invalid-json', 'Response was not valid JSON'],
  ['body-too-large', 'Response exceeded the probe limit'], ['contract-rejected', 'Response contract not recognized'],
  ['read-error', 'Response could not be read'], ['probe-error', 'Probe could not complete'],
]);
const checkoutWindows = checkoutHistory ? [...(checkoutHistory.active ? [checkoutHistory.active] : []), ...checkoutHistory.recent] : [];
const numeric = (value: unknown, digits = 0) => typeof value === 'number' && Number.isFinite(value) ? new Intl.NumberFormat('en-US', { maximumFractionDigits: digits }).format(value) : 'Unavailable';
const minutes = (value: unknown) => typeof value === 'number' && Number.isFinite(value) ? `${numeric(value / 60, 1)} min` : 'Unavailable';
const dollars = (value: unknown) => typeof value === 'number' && Number.isFinite(value) ? new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(value) : 'Unavailable';
---
<BackroadPage title={title} description="A public record of building and operating Backroad Bum with EmDash and DinkusKit.">
<section class="brb-page dashboard" data-dashboard-view={view}>
  <header class="dashboard-intro"><p class="dashboard-kicker">Backroad Bum · public experiment</p>
  <h1>{overview ? 'A store, built in the open.' : title}</h1>
  <p class="lead">{overview ? 'Backroad Bum is a working merchant experiment for EmDash and DinkusKit. This is the record of what is deployed, what is still missing and what running it teaches us.' : view === 'history' ? 'The dated record, newest first. Earlier observations stay intact; the overview reports the current serving state.' : 'Store-discovered friction, fork candidates and upstream reviews. Passing checks are not a release or a shared-service deployment.'}</p>
  </header>
  <nav class="dashboard-nav" aria-label="Dashboard pages"><a href="/dashboard/" aria-current={overview ? 'page' : undefined}>Overview</a><a href="/dashboard/history/" aria-current={view === 'history' ? 'page' : undefined}>Build history</a><a href="/dashboard/contributions/" aria-current={view === 'contributions' ? 'page' : undefined}>Contributions</a></nav>
  {overview && <>
  <details class="dashboard-jump"><summary>On this page</summary><nav class="dashboard-nav dashboard-sections" aria-label="Dashboard sections"><a href="#current">Current state</a><a href="#history">Latest work</a><a href="#contributions">Reviews &amp; accepted fixes</a><a href="#redesign">Design showcase</a><a href="#emdash-bugs">EmDash review</a><a href="#costs">Activity & costs</a><a href="#instructions">Instructions</a></nav></details>
  <section id="current"><h2>Current state</h2>
    <DashboardPulse status={status} stale={stale} />
    <details class="dashboard-disclosure"><summary>Deployment, catalog &amp; recovery details</summary><p><strong>Owner Steer 1:</strong> connect through the real hosted DinkusKit customer flow with unmodified Registry plugins. The redundant local Payments and practice Ship services are now stopped and disabled; signed plugins use the hosted platform. The cart fix merged as PR #212; desktop, phone and Registry CI checks passed. A fresh hosted Stripe TEST payment, paid receipt and sandbox fulfillment are now proven; public demo checkout is open again.</p><p>Seven EmDash-backed product families, including three-size tee and fleece designs and a pocket notebook, two collections, a persistent guest cart and ten field notes, with Commerce-owned pricing. Signed Registry Commerce 0.8.0, Payments 0.5.0 and Ship 0.3.1 are installed, with the catalog and order history preserved. Commerce, Payments and Ship are connected to hosted DinkusKit. TEST checkout settings now use $5 shipping, free from $75; the native refresh restored retained receipts. Fresh native Payments checks now report TEST readiness, superseding the earlier CAPTCHA snapshot. A shopper paid $21 for a bandana and shipping through the private same-origin preview; Payments confirms the provider payment and canonical TEST order #1006. Native Ship bought one free USPS sandbox label, its PDF reprints identically, and Commerce recorded matching completion and tracking. Public TEST checkout reopened after that proof; the verified-mailbox Account form is now independently open after TEST1010 and real email proof. Checkout request limits remain durable and health checks create no checkout capability.</p>
    <dl class="status-list">
      <div><dt>Store process</dt><dd>{show(status?.services?.backroadbum)}</dd></div>
      <div><dt>HTTPS proxy</dt><dd>{show(status?.services?.caddy)}</dd></div>
      <div><dt>Local Payments · retired</dt><dd>{show(status?.services?.['backroadbum-payments'])} · disabled at retirement</dd></div>
      <div><dt>Local practice Ship · retired</dt><dd>{show(status?.services?.['backroadbum-ship'])} · disabled at retirement</dd></div>
      <div><dt>Historical local Ship proof</dt><dd>Authenticated packing setup · not hosted fulfillment</dd></div>
      <div><dt>Old Stripe TEST webhook</dt><dd>Disabled November 10 · endpoint retained, not deleted</dd></div>
      <div><dt>Former local API routes</dt><dd>Closed with HTTP 404 · hosted Connect proof routes remain public</dd></div>
      <div><dt>Admin boundary</dt><dd>{status?.http?.['/_emdash/admin'] === 401 ? 'Authenticated access required (HTTP 401)' : 'Unavailable — check required'}</dd></div>
      <div><dt>Shopper API boundary</dt><dd>{status?.shopperAccounts?.state === 'capability-required' ? 'Commerce requires a shopper session' : status?.shopperAccounts?.state === 'blocked-by-admin-auth' ? 'Blocked by merchant authentication — check required' : 'Unavailable'}</dd></div>
      <div><dt>Agent catalog</dt><dd><a href="/feeds/agent-catalog.json">JSON feed</a> · seven eligible families, eleven concrete members · real HTTPS ingestion and nineteen local Worker checks pass · five native panel saves, two documented API writes because <a href="https://github.com/dinkuskit/commerce/issues/279">variant feed controls are missing</a> · <a href="https://github.com/dinkuskit/commerce/issues/281">Google XML/Meta CSV omit six size members</a> · <a href="https://github.com/dinkuskit/commerce/pull/282">merged PR #282 qualifies eleven source-built rows</a>, not installed here · <a href="https://github.com/dinkuskit/template-store/pull/244">Template #244 supplies selected member landings</a>; the merchant producer retains its own item query, while the signed serializer still ignores this metadata · no external enrollment or shared catalog deployment</dd></div>
      <div data-server-cart-staging><dt>Server-cart staging</dt><dd>The <a href="https://github.com/saarius/template-store/tree/backroadbum/server-cart-prep">Field Journal branch</a> pairs with Commerce beta.5 for order lookup; a separate beta.6 source rehearsal recovered a synthetic 0.8 receipt with its canonical number and TEST badge, as added in <a href="https://github.com/dinkuskit/commerce/pull/286">Commerce #286</a>. The live cart still uses signed Commerce 0.8.0. The same-ID signed upgrade and current shopper account replacement are not yet verified. <a href="/dashboard/history/">See earlier rehearsals</a>.</dd></div>
      <div><dt>Email sign-in</dt><dd>Verified-destination sandbox open · real email and the shopper form match TEST1010 while excluding nine earlier guest Orders · wrong/pasted PIN, profile save/reload/clear and session revocation verified · arbitrary visitor addresses cannot receive codes on Cloudflare Free</dd></div>
      <div><dt>Hosted test checkout</dt><dd>Latest self-dogfood: TEST1010, one Field Book, $12 + $5 shipping = $17 · one Stripe TEST payment and matching shopper account Order · Completed with one free USPS sandbox label and matching own-orders carrier/tracking · original payment retained · guest receipt fulfillment remains the separate Commerce #275 gap</dd></div>
      <div><dt>Closed-tab recovery</dt><dd>TEST Order #1007 saved by the background task before a post-payment receipt check · receipt recovered · no new label</dd></div>
      <div><dt>Address correction</dt><dd>Order #1007 corrected and restored · hosted Ship synchronized · stale save refused · still unlabelled</dd></div>
      <div><dt>Variant packing</dt><dd>TEST order #1008 paid $73 for M/L tees and shipping · address corrected through Commerce · one USPS sandbox label/PDF and matching completion verified · frozen choices intact · native Orders and Ship still omit sizes · <a href="https://github.com/dinkuskit/commerce/pull/263">PR #263</a> addresses Orders only; <a href="https://github.com/dinkuskit/commerce/issues/264">#264 tracks Ship’s missing choices</a></dd></div>
      <div><dt>Fleece sizes &amp; fit</dt><dd><a href="/products/last-light-fleece">Last Light Fleece</a> now has M/L/XL at $68 · original M identity, price and stock preserved · L in stock, XL available on backorder · native measuring instructions and explicitly illustrative dimensions · no dispatch-date promise</dd></div>
      <div><dt>Catalog shipping weights</dt><dd>Tee M 6 oz / L 6.5 oz / XL 7 oz saved through native Commerce · illustrative demo inputs, not measured samples or whole-package weights · paid Orders and existing labels unchanged</dd></div>
      <div><dt>Native package weight</dt><dd>Missing item weights appear as 0 oz without a warning in signed Ship · <a href="https://github.com/dinkuskit/ship/pull/97">PR #97</a> marks the total incomplete and asks for a weighed package · locally verified, not released</dd></div>
      <div><dt>Hosted shipping threshold</dt><dd>$74 basket + $5 shipping; $76 basket ships free · Commerce and Stripe agree · unpaid sessions only</dd></div>
      <div><dt>Checkout review</dt><dd>Phone order summary before contact entry · desktop summary stays on the right · one editable Commerce view</dd></div>
      <div><dt>Contact corrections</dt><dd>Corrections sit below their fields and focus the first invalid control · its own edits clear the correction without moving focus; unrelated edits retain it · validation and payment guards unchanged · <a href="https://github.com/dinkuskit/template-store/pull/223">PR #223</a> now includes the generic field-level repair</dd></div>
      <div><dt>Option stock feedback</dt><dd>Variant availability uses a retained polite, atomic status region · native radio focus and Commerce facts preserved · Chromium accessibility-tree properties verified, physical screen-reader speech untested · <a href="https://github.com/dinkuskit/template-store/pull/241">generic PR #241</a> now includes native Before/After proof, 44px starter controls and default dark action contrast correction; signed Commerce and merchant styling stay unchanged</dd></div>
      <div><dt>Option search</dt><dd><a href="/search?q=XL">Search XL</a> · an empty native result can now find published product options through Commerce · exact member links distinguish sold-out tee XL from backordered fleece XL · native content results and prices remain unchanged</dd></div>
      <div><dt>Product identifiers</dt><dd>Selected sizes never borrow the default size’s SKU, GTIN or MPN · missing member identifiers are omitted · simple-product identifiers stay visible</dd></div>
      <div><dt>Product pictures</dt><dd>Bandana detail plus mug handle/rim crops attached through native Commerce · all pictures in HTML · desktop grid and phone scroll-snap strip · keyboard-accessible full-size image links work without JavaScript and leave the shopping tab open</dd></div>
      <div><dt>Editorial</dt><dd>Ten EmDash field notes · latest: <a href="/field-note-a-shady-place-to-stop">A shady place to stop</a> · native headings, a three-step stop routine, cap/collection reading and draft privacy verified</dd></div>
      <div><dt>County Line Field Book</dt><dd><a href="/products/county-line-field-book">Pocket notebook</a> · $12 and in stock through Commerce · original illustration and native specifications/care · Road day keeps the notebook ahead of the backordered tote · draft isolation and published two-unit cart intent verified · subsequently paid and fulfilled in sandbox as TEST1009</dd></div>
      <div><dt>Native availability</dt><dd>Tote available on backorder at $32 · saved in Commerce · visible through checkout review without an invented dispatch date</dd></div>
      <div><dt>Tote design &amp; care</dt><dd><a href="/products/glovebox-field-tote">Glovebox Field Tote</a> · four native specification rows preserve the original canvas, 16 × 15-inch body, open top and two handles · packing and care stay separate from Commerce facts · dimensions are illustrative, not a measured sample or a tested carrying-load rating</dd></div>
      <div><dt>Bandana design &amp; care</dt><dd><a href="/products/switchback-bandana">Switchback Bandana</a> · four native specification rows for cotton, design size, artwork and corner detail · separate use/care disclosure · illustrative dimensions and decorative-not-a-map guidance · original gallery and $14 in-stock Commerce facts retained</dd></div>
      <div><dt>Native pricing</dt><dd>Bandana Sale $14, Regular $16 in Commerce · current shopping views show $14 · existing paid receipt keeps its $16 line</dd></div>
      <div><dt>Unpaid recovery</dt><dd>The original $79 / $76 / $73 attempts now return released-retry and durably record expired-unpaid · saved capability, attempt and cart retained · explicit status checks enable checkout review without a replacement start · <a href="https://github.com/dinkuskit/payments/issues/118#issuecomment-6870701600">November 14 hosted recovery proof</a> · the maintainer closed #118 November 20 as resolved by #119; provider objects and exact deployed source remain independently unverified</dd></div>
      <div><dt>Payment-page size labels</dt><dd>M and L remain distinct in Commerce but look identical in Stripe · reported as Commerce #262</dd></div>
      <div><dt>Collection discovery</dt><dd>Road day and Slow camp remain published · unused starter Tees, Hats and Hoodies retained as private drafts · search no longer offers empty starter collections</dd></div>
      <div><dt>Collection merchandising</dt><dd>Native published product order · Road day leads with the bandana and keeps the backordered tote last · saved drafts stay private</dd></div>
      <div><dt>Checkout keyboard</dt><dd>Enter in a contact field now uses the same validation and protected payment handoff as the checkout button · duplicate in-flight submissions refused · browser tests intercept every write</dd></div>
      <div><dt>Cart detail recovery</dt><dd>Product-detail retries keep keyboard focus while busy and after another refusal · successful recovery reaches the same saved item · moving elsewhere never pulls focus back · selected sizes and invalid quantity drafts stay intact</dd></div>
      <div><dt>Shopper flow</dt><dd>Public TEST checkout open · verified-mailbox account form open · guest checkout needs no account</dd></div>
      <div><dt>Public admission</dt><dd>{show(status?.checkout?.admission)} · {show(status?.checkout?.state)}</dd></div>
      <div><dt>Fulfillment</dt><dd>Hosted USPS sandbox label printed · canonical TEST completion · no live carrier scans</dd></div>
      <div><dt>Guest fulfillment visibility</dt><dd>Existing order #1008 still has matching tracking in native and hosted Ship; its signed guest receipt exposes paid facts only · <a href="https://github.com/dinkuskit/commerce/issues/275">Commerce #275</a> requests a scoped guest read, not an accepted contract or deployed fix</dd></div>
      <div><dt>Non-creating checkout probe</dt><dd>{show(status?.checkout?.healthHttp, ' HTTP')}</dd></div>
      <div><dt>Latest probe result / elapsed time</dt><dd data-checkout-probe>{probeLabels.get(checkoutProbe?.outcome ?? '') ?? 'Unavailable'} · {numeric(checkoutProbe?.elapsedMs)} ms</dd></div>
      <div><dt>CPU sample</dt><dd>{show(status?.host?.cpuPercent, '%')}</dd></div>
      <div><dt>Memory used / total</dt><dd>{show(status?.host?.usedMiB)} / {show(status?.host?.totalMiB)} MiB</dd></div>
      <div><dt>Swap used</dt><dd>{show(status?.host?.swapUsedMiB, ' MiB')}</dd></div>
      <div><dt>Disk used / total</dt><dd>{show(status?.host?.diskUsedGiB)} / {show(status?.host?.diskTotalGiB)} GiB</dd></div>
      <div><dt>Last local backup</dt><dd>{show(status?.backupAt)}</dd></div>
      <div><dt>Latest archive media check</dt><dd data-upload-recovery>{uploadRecoverySummary(status?.uploadRecovery)}</dd></div>
      <div><dt>Recovery coverage</dt><dd>Backup commands check ready media sizes/hashes automatically · encrypted settings recovered in a separate local drill · November 16 opt-in runtime drill served six fixed pages, eight archived published Field Notes, the installed Commerce catalog, seven-family/eleven-member agent feed and matching media in a private network namespace · ten Orders and all scoped business/plugin-storage/media rows retained · current deployed code/dependencies reused, not restored from backup · admin sign-in, hosted authorization and off-host recovery unverified</dd></div>
      <div><dt>Unique visitors / visitor orders</dt><dd>Unavailable · no visitor identifiers or order attribution</dd></div>
    </dl></details>
    <p class="small" data-sample-time>Metrics refresh independently every minute. Last sample: {show(status?.collectedAt)}{stale ? ' · stale or unavailable' : ''}. Readiness is an advisory, not proof of payment. Retired-service data remains in private local recovery; it is not hosted fulfillment.</p>
    <details class="dashboard-disclosure" data-traffic-observations><summary>Page-response counts &amp; privacy</summary>
      <p>Recorded since {status?.traffic ? <time datetime={status.traffic.since}>{observationTime(status.traffic.since)}</time> : 'Unavailable'}; no earlier traffic is backfilled. These are successful HTML navigation responses, not people, sessions or sales.</p>
      <dl class="status-list"><div><dt>Today · UTC</dt><dd>{trafficReady ? numeric(status?.traffic?.today) : 'Unavailable'}</dd></div><div><dt>Last 7 UTC days</dt><dd>{trafficReady ? numeric(status?.traffic?.last7Days) : 'Unavailable'}</dd></div><div><dt>Last 30 UTC days</dt><dd>{trafficReady ? numeric(status?.traffic?.last30Days) : 'Unavailable'}</dd></div></dl>
      <p>Known bots, headless browsers, tagged self-checks, editor previews, prefetches, errors and non-page requests are excluded; unrecognized automation can remain and repeat views count again. Only daily totals are retained for 90 days—no IP addresses, cookies, queries, referrers, user agents or request logs; missing or stale observations stay unavailable.</p>
    </details>
    <section data-checkout-history aria-labelledby="checkout-observations-title">
      <h3 id="checkout-observations-title">Checkout readiness history</h3>
      {checkoutHistory ? <>
        <p>Monitoring began <time datetime={checkoutHistory.since}>{observationTime(checkoutHistory.since)}</time>. The latest five unavailable windows are retained, plus any open window. These are sampled observations, not continuous uptime or payment outcomes.</p>
        {checkoutWindows.length === 0 ? <p>No unavailable observations have been recorded since monitoring began. Earlier history is not backfilled.</p> : <ol>{checkoutWindows.map(window => <li>
          <p>Unavailable observed <time datetime={window.firstObservedAt}>{observationTime(window.firstObservedAt)}</time> through <time datetime={window.lastObservedAt}>{observationTime(window.lastObservedAt)}</time>: {window.unavailableSamples} unavailable {window.unavailableSamples === 1 ? 'sample' : 'samples'}; last HTTP {window.lastHttp ?? 'unavailable'}.
          {window.endingState ? <> Next observed: {window.endingState === 'ready-advisory' ? 'test readiness supported' : 'admission closed, not a readiness recovery'} at <time datetime={window.endedAt}>{observationTime(window.endedAt)}</time>.</> : <> Unavailable at the last sample.</>}</p>
        </li>)}</ol>}
        {checkoutHistory.lastGap && <p>Last gap between retained samples: <time datetime={checkoutHistory.lastGap.after}>{observationTime(checkoutHistory.lastGap.after)}</time> and <time datetime={checkoutHistory.lastGap.before}>{observationTime(checkoutHistory.lastGap.before)}</time>. The state in between is unknown.</p>}
      </> : <p>Unavailable — no readable observation history. Missing history is not zero failures.</p>}
    </section>
  </section>
  <section id="history"><h2>Latest work</h2>
    <article class="dashboard-latest" data-retained-beta6-dispatch><p class="dashboard-kicker">November 23 · Off-live checkout rehearsal</p><h3>An earlier receipt still adds up.</h3><p>Commerce beta.6 recovered a synthetic order saved by 0.8 with its original $32 total, canonical number and TEST badge. A pending attempt stayed unconfirmed and both reads left the new cart alone. See the <a href="/pr-proof/retained-beta6/receipt-390-dark.png">staged receipt</a> and the <a href="/pr-proof/retained-beta6/lookup-390-dark.jpg">separate order lookup</a>, which accepts a printed TEST number or digits. Neither change is live.</p></article>
    <article class="dashboard-latest" data-cart-focus-followup-dispatch><p class="dashboard-kicker">November 23 · Cart review</p><h3>Keep your place after a cart change.</h3><p>The starter’s <a href="https://github.com/dinkuskit/template-store/pull/243">cart save lock has merged</a>. The follow-up <a href="https://github.com/dinkuskit/template-store/pull/246">keyboard fix</a> keeps focus on Update, moves it to a remaining item after removal, and leaves it alone when the shopper moves to navigation. The <a href="/pr-proof/template-pr246-dawn-focus/before-mobile.png">before</a> and <a href="/pr-proof/template-pr246-dawn-focus/after-mobile.png">after</a> show the starter in Dark mode. The focus fix is still in review, not on Backroad Bum’s live cart.</p></article>
    <article class="dashboard-latest" data-cart-reminder-off-dispatch><p class="dashboard-kicker">November 23 · Checkout rehearsal</p><h3>Reminders off means no reminder.</h3><p>In an isolated <a href="https://github.com/dinkuskit/template-store/pull/256">starter checkout</a>, Commerce released an expired test attempt without sending a reminder. Checkout still offered a separate news checkbox. The Backroad Bum cutover plan keeps reminders off and leaves out the news prompt unless we have a newsletter to send.</p></article>
    <article class="dashboard-latest" data-reviews-rollout-dispatch><p class="dashboard-kicker">November 22 · Reviews rehearsal</p><h3>Review tools passed. The Registry handoff did not.</h3><p>In a test store, a shopper posted a review without JavaScript and a merchant held, published, replied to and hid reviews. A separate rehearsal sent one request to a local test inbox, even after the order was reopened and completed again. With Registry plugin IDs, the timer could not find Commerce’s outbox; <a href="https://github.com/dinkuskit/courier/issues/3">Courier issue #3</a> has both results. Reviews are not installed on Backroad Bum.</p></article>
    <article class="dashboard-latest" data-beta5-cart-mail-dispatch><p class="dashboard-kicker">November 22 · Upgrade rehearsal</p><h3>Old carts, no unexpected reminders.</h3><p><a href="https://github.com/dinkuskit/commerce/releases/tag/v0.9.0-beta.5">Commerce beta.5</a> adds reminders for unpaid carts. In a disposable store, an old cart still opened and its saved setting survived the move from EmDash 1.4 to 1.5. The new background check sent no reminder for that cart. Backroad Bum remains on stable Commerce 0.8.0.</p></article>
    <article class="dashboard-latest" data-cart-agent-refresh-dispatch><p class="dashboard-kicker">November 22 · Cart review</p><h3>The cart catches up after a save.</h3><p>When a shopper saves a quantity and an assistant edits the cart before that save finishes, the old response could leave the cart lines and subtotal behind the badge. <a href="https://github.com/dinkuskit/template-store/pull/243">Template #243</a> now reloads the lines once the save unlocks. <a href="/pr-proof/template-pr243-webmcp/before-mobile.png">Before</a> / <a href="/pr-proof/template-pr243-webmcp/after-mobile.png">After</a> proof shows the difference on the starter, not on the live cart.</p></article>
    <article class="dashboard-latest" data-emdash15-refresh-dispatch><p class="dashboard-kicker">November 22 · Starter verification</p><h3>Cart and product options on EmDash 1.5.</h3><p>The starter now pairs with Commerce beta.4. A fresh signed beta install seeded nine demo product pages in a disposable store and kept the catalog unchanged on restart. The <a href="/pr-proof/template-pr243-emdash15/after-mobile.png">cart lock</a> and <a href="/pr-proof/template-pr248-emdash15/after-mobile-dark.png">sold-out size</a> were both rechecked on the new pairing, not deployed to Backroad Bum.</p></article>
    <article class="dashboard-latest" data-emdash-bridge-dispatch><p class="dashboard-kicker">November 22 · Off-live upgrade rehearsal</p><h3>Old orders survive the handoff.</h3><p>A disposable store kept its sample orders when <a href="https://github.com/dinkuskit/commerce/releases/tag/v0.9.0-beta.4">Commerce beta.4</a> ran first on EmDash 1.4, then on 1.5. Order lookup found purchases made before email indexing and refused mismatched details.</p><p>Accounts also passed its sandbox sign-in and address checks with a test mail sink. The live store remains on Commerce 0.8.0; neither the upgrade nor a new test purchase has run here.</p></article>
    <article class="dashboard-latest" data-cart-lock-dispatch><p class="dashboard-kicker">November 22 · Maintainer follow-up</p><h3>One cart change at a time.</h3><p><a href="https://github.com/dinkuskit/template-store/pull/243">Template #243</a> now locks quantity and removal controls while a change saves. A second submit is ignored, not queued; the rendered cart agrees with Commerce after the save. The <a href="/pr-proof/template-pr243-lock/before-mobile.png">before</a> and <a href="/pr-proof/template-pr243-lock/after-mobile.png">after</a> captures show the controls during a save. This is starter proof, not a live cart change.</p><p>Steers 8–10 are archived. Accounts, Reviews and Courier stay off the live store while their integrations take shape.</p></article>
    <article class="dashboard-latest" data-review-refresh-dispatch><p class="dashboard-kicker">November 22 · Maintainer follow-up</p><h3>Product options, ready for another look.</h3><p>Refreshed <a href="https://github.com/dinkuskit/template-store/pull/241">Template #241</a> against current main without rebasing, with fresh <a href="/pr-proof/template-pr241-refresh/before-mobile.png">Before</a> / <a href="/pr-proof/template-pr241-refresh/after-mobile.png">After</a> phone proof. Typecheck, 575 units, 103 workflow checks, targeted desktop/phone tests and Registry compilation pass; <a href="https://github.com/dinkuskit/template-store/actions/runs/45044114109">current-head CI passes all four browser shards and aggregate verification</a> after resolving an upstream workflow/head mismatch.</p><p>Template #244 merged. The maintainer wants a cart mutation lock in #243, a simpler focus rule in #246 after that merge, and #248 refreshed after #241; account work remains deferred. Only reporting changes here: stable Commerce is still 0.8.0, with no new purchase or live cart upgrade.</p></article>
