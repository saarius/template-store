---
import { readFile } from 'node:fs/promises';
import BackroadPage from '../store-shell/BackroadPage.astro';
import { uploadRecoverySummary } from './upload-recovery';
import DashboardPulse from './DashboardPulse.astro';
import DashboardReviews from './DashboardReviews.astro';
import DashboardShowcase from './DashboardShowcase.astro';
import DashboardEvidence from './DashboardEvidence.astro';
import './dashboard.css';
interface Props { view?: 'overview' | 'history' | 'contributions' }
const { view = 'overview' } = Astro.props;
const overview = view === 'overview';
const title = overview ? 'The experiment' : view === 'history' ? 'Build history' : 'DinkusKit contributions';
let status: any = null;
if (overview) {
  try { status = JSON.parse(await readFile('/var/lib/backroadbum/telemetry.json','utf8')); } catch {}
}
const show = (value: unknown, suffix = '') => value === null || value === undefined ? 'Unavailable' : `${value}${suffix}`;
const stale = status ? Date.now() - Date.parse(status.collectedAt) > 180000 : true;
const activity = status?.activity?.schema === 'backroadbum.activity/v1' ? status.activity : null;
const checkoutHistory = status?.checkoutHistory?.schema === 'backroadbum.checkout-observations/v1' ? status.checkoutHistory : null;
const checkoutProbe = status?.checkoutProbe?.schema === 'backroadbum.checkout-probe/v1' ? status.checkoutProbe : null;
const probeLabels = new Map<string, string>([
  ['ready-advisory', 'Test readiness supported'], ['admission-closed', 'Admission deliberately closed'],
  ['readiness-unavailable', 'Readiness advisory unavailable'], ['timeout', 'Probe timed out'],
  ['network-error', 'Network request failed'], ['invalid-json', 'Response was not valid JSON'],
  ['body-too-large', 'Response exceeded the probe limit'], ['contract-rejected', 'Response contract not recognized'],
  ['read-error', 'Response could not be read'], ['probe-error', 'Probe could not complete'],
]);
const checkoutWindows = checkoutHistory ? [...(checkoutHistory.active ? [checkoutHistory.active] : []), ...checkoutHistory.recent] : [];
const observationTime = (value: string) => new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false, timeZone: 'UTC', timeZoneName: 'short' }).format(new Date(value));
const numeric = (value: unknown, digits = 0) => typeof value === 'number' && Number.isFinite(value) ? new Intl.NumberFormat('en-US', { maximumFractionDigits: digits }).format(value) : 'Unavailable';
const minutes = (value: unknown) => typeof value === 'number' && Number.isFinite(value) ? `${numeric(value / 60, 1)} min` : 'Unavailable';
const dollars = (value: unknown) => typeof value === 'number' && Number.isFinite(value) ? new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(value) : 'Unavailable';
---
<BackroadPage title={title} description="A public record of building and operating Backroad Bum with EmDash and DinkusKit.">
<section class="brb-page dashboard" data-dashboard-view={view}>
  <header class="dashboard-intro"><p class="dashboard-kicker">Backroad Bum · public experiment</p>
  <h1>{overview ? 'A store, built in the open.' : title}</h1>
  <p class="lead">{overview ? 'Backroad Bum is a working merchant experiment for EmDash and DinkusKit. This is the record of what is deployed, what is still missing and what running it teaches us.' : view === 'history' ? 'The dated record, newest first. Earlier observations stay intact; the overview reports the current serving state.' : 'Store-discovered friction, fork candidates and upstream reviews. Passing checks are not a release or a shared-service deployment.'}</p>
  </header>
  <nav class="dashboard-nav" aria-label="Dashboard pages"><a href="/dashboard/" aria-current={overview ? 'page' : undefined}>Overview</a><a href="/dashboard/history/" aria-current={view === 'history' ? 'page' : undefined}>Build history</a><a href="/dashboard/contributions/" aria-current={view === 'contributions' ? 'page' : undefined}>Contributions</a></nav>
  {overview && <>
  <details class="dashboard-jump"><summary>On this page</summary><nav class="dashboard-nav dashboard-sections" aria-label="Dashboard sections"><a href="#current">Current state</a><a href="#history">Latest work</a><a href="#contributions">Open reviews</a><a href="#redesign">Design showcase</a><a href="#emdash-bugs">EmDash review</a><a href="#costs">Activity & costs</a><a href="#instructions">Instructions</a></nav></details>
  <section id="current"><h2>Current state</h2>
    <DashboardPulse status={status} stale={stale} />
    <details class="dashboard-disclosure"><summary>Deployment, catalog &amp; recovery details</summary><p><strong>Owner Steer 1:</strong> connect through the real hosted DinkusKit customer flow with unmodified Registry plugins. The redundant local Payments and practice Ship services are now stopped and disabled; signed plugins use the hosted platform. The cart fix merged as PR #212; desktop, phone and Registry CI checks passed. A fresh hosted Stripe TEST payment, paid receipt and sandbox fulfillment are now proven; public demo checkout is open again.</p><p>Six EmDash-backed product families, including three-size tee and fleece designs and a bandana, two collections, a persistent guest cart and six field notes, with Commerce-owned pricing. Signed Registry Commerce 0.8.0, Payments 0.5.0 and Ship 0.3.1 are installed, with the catalog and order history preserved. Commerce, Payments and Ship are connected to hosted DinkusKit. TEST checkout settings now use $5 shipping, free from $75; the native refresh restored retained receipts. Fresh native Payments checks now report TEST readiness, superseding the earlier CAPTCHA snapshot. A shopper paid $21 for a bandana and shipping through the private same-origin preview; Payments confirms the provider payment and canonical TEST order #1006. Native Ship bought one free USPS sandbox label, its PDF reprints identically, and Commerce recorded matching completion and tracking. Public TEST checkout reopened after that proof; account email remains independently paused. Checkout request limits remain durable and health checks create no checkout capability.</p>
    <dl class="status-list">
      <div><dt>Store process</dt><dd>{show(status?.services?.backroadbum)}</dd></div>
      <div><dt>HTTPS proxy</dt><dd>{show(status?.services?.caddy)}</dd></div>
      <div><dt>Local Payments · retired</dt><dd>{show(status?.services?.['backroadbum-payments'])} · disabled at retirement</dd></div>
      <div><dt>Local practice Ship · retired</dt><dd>{show(status?.services?.['backroadbum-ship'])} · disabled at retirement</dd></div>
      <div><dt>Historical local Ship proof</dt><dd>Authenticated packing setup · not hosted fulfillment</dd></div>
      <div><dt>Old Stripe TEST webhook</dt><dd>Disabled November 10 · endpoint retained, not deleted</dd></div>
      <div><dt>Former local API routes</dt><dd>Closed with HTTP 404 · hosted Connect proof routes remain public</dd></div>
      <div><dt>Admin boundary</dt><dd>{status?.http?.['/_emdash/admin'] === 401 ? 'Authenticated access required (HTTP 401)' : 'Unavailable — check required'}</dd></div>
      <div><dt>Shopper API boundary</dt><dd>{status?.shopperAccounts?.state === 'capability-required' ? 'Commerce requires a shopper session' : status?.shopperAccounts?.state === 'blocked-by-admin-auth' ? 'Blocked by merchant authentication — check required' : 'Unavailable'}</dd></div>
      <div><dt>Email sign-in</dt><dd>Paused · native EmDash settings showed no email provider on November 13; delivery remains unverified · browser-bound receipts still work</dd></div>
      <div><dt>Hosted test checkout</dt><dd>Provider payment, Commerce receipt and sandbox fulfillment verified</dd></div>
      <div><dt>Closed-tab recovery</dt><dd>TEST Order #1007 saved by the background task before a post-payment receipt check · receipt recovered · no new label</dd></div>
      <div><dt>Address correction</dt><dd>Order #1007 corrected and restored · hosted Ship synchronized · stale save refused · still unlabelled</dd></div>
      <div><dt>Variant packing</dt><dd>TEST order #1008 paid $73 for M/L tees and shipping · address corrected through Commerce · one USPS sandbox label/PDF and matching completion verified · frozen choices intact · native Orders and Ship still omit sizes · <a href="https://github.com/dinkuskit/commerce/pull/263">PR #263</a> addresses Orders only; <a href="https://github.com/dinkuskit/commerce/issues/264">#264 tracks Ship’s missing choices</a></dd></div>
      <div><dt>Fleece sizes &amp; fit</dt><dd><a href="/products/last-light-fleece">Last Light Fleece</a> now has M/L/XL at $68 · original M identity, price and stock preserved · L in stock, XL available on backorder · native measuring instructions and explicitly illustrative dimensions · no dispatch-date promise</dd></div>
      <div><dt>Catalog shipping weights</dt><dd>Tee M 6 oz / L 6.5 oz / XL 7 oz saved through native Commerce · illustrative demo inputs, not measured samples or whole-package weights · paid Orders and existing labels unchanged</dd></div>
      <div><dt>Native package weight</dt><dd>Missing item weights appear as 0 oz without a warning in signed Ship · <a href="https://github.com/dinkuskit/ship/pull/97">PR #97</a> marks the total incomplete and asks for a weighed package · locally verified, not released</dd></div>
      <div><dt>Hosted shipping threshold</dt><dd>$74 basket + $5 shipping; $76 basket ships free · Commerce and Stripe agree · unpaid sessions only</dd></div>
      <div><dt>Checkout review</dt><dd>Phone order summary before contact entry · desktop summary stays on the right · one editable Commerce view</dd></div>
      <div><dt>Contact corrections</dt><dd>Corrections sit below their fields and focus the first invalid control · its own edits clear the correction without moving focus; unrelated edits retain it · validation and payment guards unchanged · <a href="https://github.com/dinkuskit/template-store/pull/223">PR #223</a> now includes the generic field-level repair</dd></div>
      <div><dt>Product identifiers</dt><dd>Selected sizes never borrow the default size’s SKU, GTIN or MPN · missing member identifiers are omitted · simple-product identifiers stay visible</dd></div>
      <div><dt>Product pictures</dt><dd>Bandana detail plus mug handle/rim crops attached through native Commerce · all pictures in HTML · desktop grid and phone scroll-snap strip, without gallery JavaScript</dd></div>
      <div><dt>Editorial</dt><dd>Six EmDash field notes · latest: <a href="/field-note-after-a-road-day">The reset after a road day</a> · native bullet list, inline links and draft privacy verified</dd></div>
      <div><dt>Native availability</dt><dd>Tote available on backorder at $32 · saved in Commerce · visible through checkout review without an invented dispatch date</dd></div>
      <div><dt>Native pricing</dt><dd>Bandana Sale $14, Regular $16 in Commerce · current shopping views show $14 · existing paid receipt keeps its $16 line</dd></div>
      <div><dt>Unpaid recovery</dt><dd>The original $79 / $76 / $73 attempts now return released-retry and durably record expired-unpaid · saved capability, attempt and cart retained · explicit status checks enable checkout review without a replacement start · <a href="https://github.com/dinkuskit/payments/issues/118#issuecomment-6870701600">November 14 hosted recovery proof</a> · provider objects and exact deployed source remain unverified</dd></div>
      <div><dt>Payment-page size labels</dt><dd>M and L remain distinct in Commerce but look identical in Stripe · reported as Commerce #262</dd></div>
      <div><dt>Collection discovery</dt><dd>Road day and Slow camp remain published · unused starter Tees, Hats and Hoodies retained as private drafts · search no longer offers empty starter collections</dd></div>
      <div><dt>Collection merchandising</dt><dd>Native published product order · Road day leads with the bandana and keeps the backordered tote last · saved drafts stay private</dd></div>
      <div><dt>Shopper flow</dt><dd>Public TEST checkout open · email sign-in remains paused</dd></div>
      <div><dt>Public admission</dt><dd>{show(status?.checkout?.admission)} · {show(status?.checkout?.state)}</dd></div>
      <div><dt>Fulfillment</dt><dd>Hosted USPS sandbox label printed · canonical TEST completion · no live carrier scans</dd></div>
      <div><dt>Guest fulfillment visibility</dt><dd>Existing order #1008 still has matching tracking in native and hosted Ship; its signed guest receipt exposes paid facts only · <a href="https://github.com/dinkuskit/commerce/issues/275">Commerce #275</a> requests a scoped guest read, not an accepted contract or deployed fix</dd></div>
      <div><dt>Non-creating checkout probe</dt><dd>{show(status?.checkout?.healthHttp, ' HTTP')}</dd></div>
      <div><dt>Latest probe result / elapsed time</dt><dd data-checkout-probe>{probeLabels.get(checkoutProbe?.outcome) ?? 'Unavailable'} · {numeric(checkoutProbe?.elapsedMs)} ms</dd></div>
      <div><dt>CPU sample</dt><dd>{show(status?.host?.cpuPercent, '%')}</dd></div>
      <div><dt>Memory used / total</dt><dd>{show(status?.host?.usedMiB)} / {show(status?.host?.totalMiB)} MiB</dd></div>
      <div><dt>Swap used</dt><dd>{show(status?.host?.swapUsedMiB, ' MiB')}</dd></div>
      <div><dt>Disk used / total</dt><dd>{show(status?.host?.diskUsedGiB)} / {show(status?.host?.diskTotalGiB)} GiB</dd></div>
      <div><dt>Last local backup</dt><dd>{show(status?.backupAt)}</dd></div>
      <div><dt>Latest archive media check</dt><dd data-upload-recovery>{uploadRecoverySummary(status?.uploadRecovery)}</dd></div>
      <div><dt>Recovery coverage</dt><dd>Backup commands now check the latest completed archive offline · ready media sizes/hashes only; cached plugins are restored, not signature-qualified · encrypted settings recovered in a separate local drill · full runtime, admin sign-in, hosted authorization and off-host recovery unverified</dd></div>
      <div><dt>Visitor / order aggregates</dt><dd>Unavailable · counting is not wired yet</dd></div>
    </dl></details>
    <p class="small" data-sample-time>Metrics refresh independently every minute. Last sample: {show(status?.collectedAt)}{stale ? ' · stale or unavailable' : ''}. Readiness is an advisory, not proof of payment. Retired-service data remains in private local recovery; it is not hosted fulfillment.</p>
    <section data-checkout-history aria-labelledby="checkout-observations-title">
      <h3 id="checkout-observations-title">Checkout readiness history</h3>
      {checkoutHistory ? <>
        <p>Monitoring began <time datetime={checkoutHistory.since}>{observationTime(checkoutHistory.since)}</time>. The latest five unavailable windows are retained, plus any open window. These are sampled observations, not continuous uptime or payment outcomes.</p>
        {checkoutWindows.length === 0 ? <p>No unavailable observations have been recorded since monitoring began. Earlier history is not backfilled.</p> : <ol>{checkoutWindows.map(window => <li>
          <p>Unavailable observed <time datetime={window.firstObservedAt}>{observationTime(window.firstObservedAt)}</time> through <time datetime={window.lastObservedAt}>{observationTime(window.lastObservedAt)}</time>: {window.unavailableSamples} unavailable {window.unavailableSamples === 1 ? 'sample' : 'samples'}; last HTTP {window.lastHttp ?? 'unavailable'}.
          {window.endingState ? <> Next observed: {window.endingState === 'ready-advisory' ? 'test readiness supported' : 'admission closed, not a readiness recovery'} at <time datetime={window.endedAt}>{observationTime(window.endedAt)}</time>.</> : <> Unavailable at the last sample.</>}</p>
        </li>)}</ol>}
        {checkoutHistory.lastGap && <p>Last gap between retained samples: <time datetime={checkoutHistory.lastGap.after}>{observationTime(checkoutHistory.lastGap.after)}</time> and <time datetime={checkoutHistory.lastGap.before}>{observationTime(checkoutHistory.lastGap.before)}</time>. The state in between is unknown.</p>}
      </> : <p>Unavailable — no readable observation history. Missing history is not zero failures.</p>}
    </section>
  </section>
  <section id="history"><h2>Latest work</h2>
    <article class="dashboard-latest"><p class="dashboard-kicker">November 14 · merchant workflow</p><h3>A saved weight, a dismissed drawer.</h3><p>An isolated phone-editor replay now explains the Settings dismissal: the saved form replaces its focused button, and the resulting focus-leave event closes the mobile sheet. Click and keyboard Enter both reproduce it; native reopening shows the saved value, while desktop keeps its controls.</p><p><a href="#emdash-bugs">Read the human-review finding</a>, with synthetic before/after-save captures and a verified reopening workaround, or <a href="/dashboard/history/">read the build history</a>. No EmDash fix or live product edit is claimed; the store’s signed plugins and payment records are unchanged.</p></article>
    <details class="dashboard-disclosure"><summary>Earlier dispatches &amp; verification context</summary><p>Last Light Fleece now offers M, L and XL through signed Commerce at $68, retaining M’s identity and stock; L is in stock and XL is available on backorder, without an invented dispatch date. Native fit guidance labels dimensions as illustrative, not measured samples. <a href="/products/last-light-fleece">Explore the fleece</a>; payment and fulfillment records are unchanged.</p><p>An operator-evidence correction: actual CMS products, pages and categories live in tables, not identically named plugin collections. The new read-only snapshot command queries those tables explicitly; earlier ad hoc empty-collection hashes do not establish CMS preservation. This cycle separately compares the real CMS rows and frozen Orders, preserving every unrelated row through native fleece publication.</p><p>Phase 3 brings calmer cart and checkout panels, proportional address fields, a screen-only receipt layout and a magazine-style Field Notes index with a more deliberate reading rhythm. Native guide/story content and the payment/recovery protocol stay intact; checkout presentation is tested with intercepted synthetic responses, not replacement payment attempts. Compare the <a href="/pr-proof/storefront-redesign/phase3-before-field-notes-1440-light.png">earlier journal</a> with the new <a href="/pr-proof/storefront-redesign/phase3-after-field-notes-1440-light.png">Light</a> and <a href="/pr-proof/storefront-redesign/phase3-after-field-notes-1440-dark.png">Dark</a> views; dashboard detail is the remaining phase.</p><p>The Field Journal rebrand now reaches the shopping routes: wider image-led product cards, collection filters, a gallery-led product layout, visible selected-size pills and a quieter search workspace. Native pictures, specifications, care copy and Commerce-owned prices stay intact; transactional, editorial and dashboard detail are the remaining phases. Compare the <a href="/pr-proof/storefront-redesign/phase2-before-shop-1440-light.png">earlier shop</a> with the new <a href="/pr-proof/storefront-redesign/phase2-after-shop-1440-light.png">Light</a> and <a href="/pr-proof/storefront-redesign/phase2-after-shop-1440-dark.png">Dark</a> views.</p><p>Owner Steer 4 starts the Field Journal rebrand: warm dual-theme surfaces, self-hosted Fraunces/DM Sans, an accessible System/Light/Dark preference and a new photographic home. Phase 1 changes presentation, not catalog or checkout authority; shop, product, editorial and dashboard refinements follow. Compare the <a href="/pr-proof/storefront-redesign/before-home-1440.png">previous home</a> with the new <a href="/pr-proof/storefront-redesign/after-home-light-1440.png">Light</a> and <a href="/pr-proof/storefront-redesign/after-home-dark-1440.png">Dark</a> views.</p><p>Search now gives matching field notes a short published opening-paragraph preview when EmDash supplies only a repeated title. Useful native snippets, result identities, ranking and Commerce visibility remain unchanged; a missing or failed optional preview leaves the title link usable. The title-column snippet behavior is recorded for human CMS review, without a CMS patch or new upstream report.</p><p>A merchant-only recovery adapter is now source-qualified against Commerce #272 at 1ef8465, but not enabled. In a disposable EmDash/workerd site, the default legacy wrapper returns unavailable against the removed status route; explicit cart-read mode recovers the original paid and unresolved capabilities, preserving the paid $32 receipt while refusing mutation bodies and other-attempt locators. No installed Payments binding or new provider session is involved; synthetic kernel replay is separate. The serving store keeps signed Commerce0.8.0 and its unchanged legacy mode; Template #229, new checkout starts, the coordinated signed beta and hosted TEST journey remain separate adoption gates.</p><p>Timer and deployment backup commands now restore the latest archive into a private temporary directory and check ready media against archived sizes and hashes before reporting success. The latest-archive row above updates independently each minute; a newer or changed archive cannot inherit an older passing result, and missing evidence stays unavailable. The current mug-era archive restores nine ready media files with matching bytes. This is offline media coverage, not a running-store or off-host recovery test; no live files, keys, checkout or fulfillment state are changed.</p><p><a href="/products/creekside-camp-mug">Creekside Camp Mug</a> now has two detail crops of its original illustration, three native EmDash specification rows and a separate care disclosure. The original lead image, summary, $18 Commerce price and availability are unchanged; captions identify illustration crops rather than product photography. Saved draft copy stayed private until native publication, while Commerce gallery attachments took effect separately. Desktop/phone checks pass with and without JavaScript, retaining keyboard care controls, metadata and cart intent without checkout starts.</p><p>The owner-requested account settings revision is now published in existing PR #124 at 92fbb24: ordinary Plugins, Shipping and Payments links, independent native saves and flat-only dollar fields. Every local verification stage passes across serial runs, including 51 shared-store tests and four no-JavaScript desktop/phone light/dark contexts; the initial local approval connection failures did not repeat on an unchanged-source retry, with cause still unknown. Four inspected public Before/After images show unchanged main beside all three tabs. Full exact-head GitHub verification passes, and fresh review accepts 92fbb24’s tab/save proof with no findings. Maintainer merge and shared deployment remain separate. The last read-only hosted observation retains TEST / $5 / $75.</p><p>Product pictures now render without a gallery script: a large lead image, a desktop grid and a phone scroll-snap strip. The owner-requested rework of Gallery #222 retains the native fixture and passes JavaScript-on/off checks at 1280px and 412px; its new public Before/After captures compare actual EmDash pages. Native lazy loading is a browser hint, not a promise of zero offscreen requests; synthetic Chromium touch is checked, not physical phones or Safari. Cart #212 and product-card #267 are merged; buying/return patches #225/#226 closed without merge. A late read-only check found open PR #229 now contains a server-cart implementation candidate at c088bfe, paired with open Commerce #272 rather than the pinned Commerce0.8.0; its author explicitly says not to merge it alone. That paired build is not adopted or independently qualified here, and original checkout browsers stay protected. Hosted settings #124’s tabbed rework is now published after stage-by-stage local qualification, not shared-deployed.</p><p>Ship #96 is now merged after the requested merge from main, with both guide paragraphs preserved. Refreshed actual served-route desktop and phone proof retains full tracking and existing-label actions; phone width improves from 532px to 390px. Template #214’s feature-map clarification is pushed as a documentation-only follow-up; local checks, focused anonymous captures and full new-head GitHub verification pass. A standalone re-review request now follows completed CI. Neither change replaces a signed plugin or deploys shared Ship.</p><p>A native EmDash email-settings check found no installed or selected provider and no test-email action. The sign-in pause is a store configuration gap, separate from hosted TEST checkout; selecting a sender will still require actual delivery and shopper-flow proof. An operator-only, read-only inspection command and Node setup runbook now make that next step explicit without sending another code or changing either admission gate.</p><p><a href="/field-note-after-a-road-day">The reset after a road day</a> is the sixth field note, authored and published through EmDash’s native editor. Its draft stayed off the public route, index and search until publication; four headings, four bullet items and two internal links now support reading and onward browsing without JavaScript. Existing pages and Commerce records are unchanged; no new styling or product-performance claim is added.</p><p><a href="https://github.com/dinkuskit/template-store/pull/214">Selected metadata #214</a> now pairs actual anonymous public member facts with the rendered JSON-LD on desktop and phone. Main gives Medium and sold-out Large the Small SKU; the head uses each member’s own SKU, or omits variant SKU and Offer on Commerce 0.8.0, while preserving the simple-product Offer. Four public storefront captures accompany the nonvisual output. The owner approved the legacy no-Offer contract on November 13; review accepted f4c6174’s proof with no findings. The requested feature-map clarification is now pushed as 40e95ea without runtime or pin changes; full new-head CI passes and re-review is requested; review remains separate. Signed plugins and live records are unchanged.</p><p><a href="https://github.com/dinkuskit/ship/pull/97">Native package weight #97</a> now has four public Before/After captures through installed EmDash and workerd on desktop and phone. Main shows 0 oz without a warning; the head marks it incomplete and keeps the warning after See prices with 16.5 oz retained. Fresh full verification and the main-fail/head-pass regression comparison pass; review accepted #97’s installed proof at 5/6 with no findings, and the fix is now merged upstream. The unsigned local installation uses synthetic issuer and hosted responses, not live quotes or a signed-plugin deployment.</p><p><a href="https://github.com/dinkuskit/ship/pull/94">Ship settings #94</a> and <a href="https://github.com/dinkuskit/ship/pull/96">phone label history #96</a> now have actual served Worker-route Before/After desktop and phone proof, replacing the earlier fixture-only qualification. Native box submission and reload pass; the phone history fits 390px instead of 532px while retaining full tracking, print and cancel. Both unchanged heads pass fresh full verification. Fresh review accepts both served proofs at 5/6 with no findings; #94 is now merged upstream and #96 remains open. Hosted Ship and live labels remain unchanged.</p><p><a href="https://github.com/dinkuskit/commerce/pull/267">Product-card continuation #267</a> now has Before/After proof through the installed EmDash product editor, not just a custom renderer. Desktop main closes Shipping over the refused -1 oz; the head retains it, accepts 7 oz without reopening and keeps Identifiers closed; reload confirms the saved 7 oz. Phone qualification stopped earlier when the whole Settings drawer disappeared after a successful save on both sources; that separate sharp edge is recorded for human review. The signed Commerce plugin and live catalog stay unchanged.</p><p><a href="https://github.com/dinkuskit/template-store/pull/216">Variant cards #216</a> now summarize listable members’ Commerce availability: best sellable In stock, Low stock, then Available on backorder; otherwise Out of stock, or unavailable when every member is unavailable. The merchant theme uses this revised helper without changing selected-option facts or live stock. Four refreshed public Before/After composites, local focused desktop/phone proof and the head’s full GitHub checks pass; #216 is now merged upstream, not a new signed release.</p><p><a href="https://github.com/dinkuskit/template-store/pull/212">Cart quantity #212</a> now has public desktop and phone Before/After proof for cart and checkout. Rejected zero restores 1 with the $24 subtotal; after a refused save, a rejected blank restores the newer in-memory 2 with $48 rather than persisted 3. The candidate uses synthetic catalog and checkout transport, starts no payment and differs from the merchant theme’s retained-draft behavior.</p><p>Ten fixes are now merged upstream: seven more accepted on November 13 join the earlier <a href="https://github.com/dinkuskit/commerce/pull/261">readable order facts #261</a>, <a href="https://github.com/dinkuskit/commerce/pull/263">frozen order choices #263</a> and <a href="https://github.com/dinkuskit/template-store/pull/218">saved-cart names #218</a>. Their public Before/After proof stays available; signed plugin installation and hosted deployment remain separate.</p><p><a href="https://github.com/dinkuskit/template-store/pull/223">Checkout contact #223</a> now puts each correction under its field, marks that control invalid and focuses it after an explicit rejected submission. Desktop and phone Before/After captures cover empty email, missing delivery postal code and incomplete billing city; own-field edits clear the correction without focus theft, while unrelated edits preserve it. These rendered-page fixtures use synthetic checkout protocol and an admission flag, not provider readiness or a signed-plugin installation.</p><p><a href="https://github.com/dinkuskit/template-store/pull/220">Cart return #220</a> now shows real Commerce sale and stock changes followed by trusted browser tab returns on desktop and phone. Main keeps the stale $24 and In stock; the head refreshes to $20 and Out of stock while retaining the same saved intent and focused quantity element.</p><p><a href="https://github.com/dinkuskit/template-store/pull/218">Saved-cart names #218</a> now shows desktop and phone Before/After publication loss and recovery through real local admin APIs, without snapshot interception. Numbered unavailable rows retain saved quantities, current catalog names return with distinct controls, and exact-item removal survives reload; this source-paired fixture is not a signed installation or payment-readiness proof.</p><p><a href="https://github.com/dinkuskit/template-store/pull/216">Variant cards #216</a> retains desktop and phone Before/Af