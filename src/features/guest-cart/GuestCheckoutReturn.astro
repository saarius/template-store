---
const { contactHref } = Astro.props;
---
<section class="guest-checkout-return" data-guest-checkout-return aria-labelledby="guest-checkout-return-title">
  <h1 id="guest-checkout-return-title">Order confirmation</h1>
  <p data-guest-checkout-return-status role="status">Checking the saved checkout status.</p>
  <section class="guest-checkout-pending-review" data-guest-checkout-pending-review aria-labelledby="guest-checkout-pending-title" hidden>
    <h2 id="guest-checkout-pending-title">Original checkout</h2>
    <dl><div><dt>Amount sent to checkout</dt><dd data-guest-checkout-pending-amount></dd></div></dl>
    <p>This is not a paid receipt. Your cart may now show different prices; this amount belongs to the original checkout.</p>
    <a href="/cart">View current cart</a>
  </section>
  {contactHref && <p data-guest-checkout-contact>Need help? <a href={contactHref}>Contact the store</a>.</p>}
  <div class="guest-checkout-receipt" data-guest-checkout-order hidden>
    <div class="guest-checkout-order-heading">
      <h2 data-guest-checkout-order-number>Order confirmed</h2>
      <span class="guest-checkout-test-badge" data-guest-checkout-test hidden>TEST</span>
    </div>
    <h3>Items</h3>
    <ul data-guest-checkout-order-items></ul>
    <dl data-guest-checkout-order-totals></dl>
    <section class="guest-checkout-destination" aria-labelledby="guest-checkout-destination-title" data-guest-checkout-destination data-guest-checkout-shipping hidden>
      <h3 id="guest-checkout-destination-title">Contact &amp; delivery details</h3>
      <div class="guest-checkout-destination__grid">
        <div class="guest-checkout-destination__item" data-guest-checkout-email-row hidden>
          <span class="guest-checkout-destination__label">Email</span>
          <p class="guest-checkout-destination__value" data-guest-checkout-email></p>
        </div>
        <div class="guest-checkout-destination__item" data-guest-checkout-recipient-row hidden>
          <span class="guest-checkout-destination__label">Recipient</span>
          <p class="guest-checkout-destination__value" data-guest-checkout-recipient></p>
        </div>
        <div class="guest-checkout-destination__item" data-guest-checkout-address-row hidden>
          <span class="guest-checkout-destination__label">Delivery address</span>
          <p class="guest-checkout-destination__value" data-guest-checkout-address></p>
        </div>
        <div class="guest-checkout-destination__item" data-guest-checkout-shipping-method-row hidden>
          <span class="guest-checkout-destination__label">Shipping method</span>
          <p class="guest-checkout-destination__value" data-guest-checkout-shipping-method></p>
        </div>
      </div>
    </section>
    <section class="guest-checkout-fulfillment" data-guest-checkout-fulfillment aria-labelledby="guest-checkout-fulfillment-title" hidden>
      <h3 id="guest-checkout-fulfillment-title">Fulfillment</h3>
      <p class="guest-checkout-fulfillment-status" data-guest-checkout-fulfillment-status></p>
      <p data-guest-checkout-fulfillment-note></p>
      <dl data-guest-checkout-fulfillment-details></dl>
    </section>
    <section class="guest-checkout-keep" data-receipt-screen-only aria-labelledby="guest-checkout-keep-title">
      <h3 id="guest-checkout-keep-title">Keep your receipt</h3>
      <p>Choose “Your last checkout” in the footer or cart to return here. This browser keeps only its latest checkout; keep its site data to reopen the receipt. The page address alone cannot recover an order.</p>
      <button type="button" data-guest-checkout-print aria-describedby="guest-checkout-print-hint" hidden>Print or save receipt</button>
      <p id="guest-checkout-print-hint">Use your browser’s print options to print a copy or save a PDF. A saved copy won’t update or restore online access.</p>
    </section>
    <p class="receipt-print-only">Receipt copy. Fulfillment reflects the last status check, not a live update. This copy does not restore online order access.</p>
    {contactHref && <p data-guest-checkout-contact>Questions? <a href={contactHref}>Contact the store</a>.</p>}
  </div>
  <a data-guest-checkout-retry hidden rel="noopener noreferrer">Continue to secure checkout</a>
  <div class="guest-checkout-actions" data-guest-checkout-actions>
    <a class="guest-checkout-continue" href="/shop">Continue shopping</a>
    <a class="guest-checkout-account" data-guest-checkout-account href="/account">Shopper account</a>
  </div>
  <button type="button" data-guest-checkout-status-retry hidden>Check status again</button>
</section>
<script>
  import { hydrateGuestCheckoutReturn } from "./guest-cart-client.ts";
  hydrateGuestCheckoutReturn();
</script>
