---
import { sanitizeHref } from 'emdash';
import type { BlockComponentProps, BlockValue } from 'emdash/ui';
type HomeValue = BlockValue & { headline?: string; deck?: string; primary_label?: string; primary_href?: string; secondary_label?: string; secondary_href?: string };
const { value, index } = Astro.props as BlockComponentProps<HomeValue>;
const Heading = index === 0 ? 'h1' : 'h2';
---
<section class="backroad-opener" data-home-opener>
  <img src="/backroad/forest.jpg" alt="A still lake reflecting tall trees beneath distant mountains" width="1600" height="1067" fetchpriority="high" />
  <div class="backroad-opener__notice">
    <Heading>{value.headline}</Heading>
    <div>
      {value.deck && <p>{value.deck}</p>}
      <nav aria-label="Start exploring">
        {value.primary_label && value.primary_href && <a class="brb-action" href={sanitizeHref(value.primary_href)}>{value.primary_label}</a>}
        {value.secondary_label && value.secondary_href && <a href={sanitizeHref(value.secondary_href)}>{value.secondary_label}</a>}
      </nav>
    </div>
  </div>
</section>
<style>
.backroad-opener{margin:1.5rem 0 0;background:var(--brb-blue);overflow:hidden;border-radius:4px}
.backroad-opener>img{display:block;width:100%;height:clamp(12rem,24vw,20rem);object-fit:cover;object-position:50% 56%}
.backroad-opener__notice{display:grid;grid-template-columns:1fr 1.05fr;gap:2rem;padding:2rem 2.5rem 2.5rem;align-items:center}
.backroad-opener h1,.backroad-opener h2{font-size:clamp(2.8rem,5.7vw,5rem);line-height:1;letter-spacing:-.025em;max-width:10ch;margin:0}
.backroad-opener p{font-size:1.05rem;line-height:1.7;max-width:42ch;margin:0 0 1.25rem}
.backroad-opener nav{display:flex;gap:1rem 1.5rem;flex-wrap:wrap;align-items:center}
.backroad-opener nav a{color:var(--store-ink);font-size:.95rem}
@media(max-width:42rem){.backroad-opener__notice{grid-template-columns:1fr;padding:1.5rem;gap:1rem}.backroad-opener>img{height:14rem}.backroad-opener h1,.backroad-opener h2{max-width:13ch}.backroad-opener p{font-size:1rem}}
</style>
