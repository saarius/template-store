---
import { sanitizeHref } from 'emdash';
import type { BlockComponentProps, BlockValue } from 'emdash/ui';
type HomeValue = BlockValue & { headline?: string; deck?: string; primary_label?: string; primary_href?: string; secondary_label?: string; secondary_href?: string };
const { value, index } = Astro.props as BlockComponentProps<HomeValue>;
const Heading = index === 0 ? 'h1' : 'h2';
---
<section class="backroad-opener" data-home-opener>
  <div class="backroad-opener__notice">
    <p class="backroad-opener__intro">Everyday camp. Out-of-the-way places.</p>
    <Heading>{value.headline}</Heading>
    {value.deck && <p class="backroad-opener__deck">{value.deck}</p>}
    <nav aria-label="Start exploring">
      {value.primary_label && value.primary_href && <a class="brb-action" href={sanitizeHref(value.primary_href)}>{value.primary_label}</a>}
      {value.secondary_label && value.secondary_href && <a class="backroad-opener__secondary" href={sanitizeHref(value.secondary_href)}>{value.secondary_label}</a>}
    </nav>
  </div>
  <figure>
    <img src="/backroad/forest.jpg" alt="A still lake reflecting tall trees beneath distant mountains" width="1600" height="1067" fetchpriority="high" loading="eager" />
    <figcaption>Less itinerary. More outside.</figcaption>
  </figure>
</section>
<style>
.backroad-opener{display:grid;grid-template-columns:minmax(0,1fr);margin:var(--space-6) 0 0;gap:var(--space-7);align-items:center}
.backroad-opener__notice{padding:var(--space-5) 0;min-width:0}
.backroad-opener__intro{font-size:var(--text-sm);font-weight:500;color:var(--color-text-muted);margin:0 0 var(--space-5)}
.backroad-opener h1,.backroad-opener h2{font-size:var(--text-display);line-height:1.08;letter-spacing:-.04em;max-width:12ch;margin:0 0 var(--space-5);font-weight:500}
.backroad-opener__deck{font-size:1rem;line-height:var(--leading-body);max-width:37ch;margin:0 0 var(--space-6);color:var(--color-text-muted)}
.backroad-opener nav{display:flex;gap:var(--space-4) var(--space-5);flex-wrap:wrap;align-items:center}
.backroad-opener__secondary{display:inline-flex;align-items:center;min-height:48px;color:var(--color-text);font-size:var(--text-sm);font-weight:500}
.backroad-opener__secondary:hover{text-decoration-thickness:2px}
.backroad-opener figure{margin:0;min-width:0;background:var(--color-surface-muted);border-radius:var(--radius-card);overflow:hidden}
.backroad-opener img{display:block;width:100%;height:auto;aspect-ratio:4/3;object-fit:cover;object-position:50% 55%}
.backroad-opener figcaption{padding:var(--space-3) var(--space-5);font-size:var(--text-sm);color:var(--color-text-muted)}
@media(min-width:60rem){.backroad-opener{grid-template-columns:minmax(0,1fr) minmax(0,1.618fr);gap:var(--space-8);margin-top:var(--space-7)}.backroad-opener img{aspect-ratio:1.25;min-height:28rem}.backroad-opener__notice{padding:var(--space-7) 0}}
</style>
