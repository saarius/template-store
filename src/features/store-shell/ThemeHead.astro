<script is:inline>
  (() => {
    let mode = 'system';
    try {
      const saved = localStorage.getItem('backroadbum.theme');
      if (saved === 'light' || saved === 'dark') mode = saved;
    } catch { /* Blocked storage still follows the device. */ }
    document.documentElement.dataset.theme = mode;
  })();
</script>
