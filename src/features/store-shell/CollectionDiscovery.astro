---
import { collectionIntroductions, type ShopCollection } from './backroad-collections.js';
import { canonicalCategoryPath } from './product-routes.js';
interface Props { collections: readonly ShopCollection[]; unavailable?: boolean }
const { collections, unavailable = false } = Astro.props;
const introductions = collectionIntroductions(collections, unavailable);
---
{introductions.length > 0 && <section class="collection-discovery" aria-label="Shop by collection" data-collection-discovery>
  {introductions.map(collection => <article>
    <h2><a href={canonicalCategoryPath(collection.slug)}>{collection.title}</a></h2>
    {collection.description && <p>{collection.description}</p>}
  </article>)}
</section>}
<style>
.collection-discovery{width:min(80rem,calc(100% - 2.5rem));margin:var(--space-8) auto 0;display:grid;grid-template-columns:minmax(0,1fr);gap:var(--space-5)}
.collection-discovery article{min-width:0;padding:var(--space-6);border:1px solid var(--color-border);border-radius:var(--radius-panel);background:var(--color-surface)}
.collection-discovery h2{margin:0;font-size:var(--text-2xl);line-height:1.2;letter-spacing:-.025em}
.collection-discovery a{display:inline-flex;align-items:center;min-height:48px;color:inherit;text-decoration-thickness:1px;text-underline-offset:.25em}
.collection-discovery a:hover{color:var(--color-primary);text-decoration-thickness:2px}
.collection-discovery p{max-width:48ch;margin:var(--space-3) 0 0;color:var(--color-text-muted);line-height:var(--leading-body);overflow-wrap:anywhere}
@media(min-width:45rem){.collection-discovery{grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-7);margin-top:var(--space-9)}}
</style>
