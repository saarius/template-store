---
import { GuestCartNav } from '../guest-cart/ui.ts';
interface Props { profile: string }
const path = Astro.url.pathname;
const links = [{url:'/shop',label:'Shop'},{url:'/field-notes',label:'Field notes'},{url:'/test-store',label:'Test-store guide'}];
---
<a class="skip-link" href="#main-content">Skip to content</a>
<header class="store-header" data-store-header>
  <a class="store-header__mark" href="/" aria-label="Backroad Bum home">BACKROAD BUM</a>
  <nav class="brb-main-nav" aria-label="Main">
    {links.map(link => <a href={link.url} aria-current={path === link.url ? 'page' : link.url === '/shop' && path.startsWith('/categories/') ? 'true' : undefined}>{link.label}</a>)}
  </nav>
  <nav class="store-header__nav" aria-label="Your shopping bag"><GuestCartNav /></nav>
</header>
<style>
.brb-main-nav{display:flex;align-items:center;gap:1.5rem;font-size:.95rem}
.brb-main-nav a{padding:.6rem 0}
.brb-main-nav a:hover,.brb-main-nav [aria-current]{text-decoration:underline;text-decoration-thickness:2px}
.skip-link{position:absolute;top:-5rem;left:1rem;z-index:100;padding:.7rem 1rem;background:var(--brb-yellow);color:var(--store-ink)}
.skip-link:focus{top:.5rem}
@media(max-width:40rem){.brb-main-nav{order:3;width:100%;gap:1.25rem;border-top:1px solid var(--store-line);padding-top:.25rem;font-size:.85rem}.store-header{padding-bottom:.5rem}}
</style>
