---
import type { ShopCollection } from './backroad-collections.js';
import { canonicalCategoryPath } from './product-routes.js';
interface Props { collections: ShopCollection[]; total: number; current?: string; unavailable?: boolean }
const { collections, total, current, unavailable = false } = Astro.props;
const visible = collections.filter(collection => collection.products.length > 0 || collection.slug === current);
---
<nav class="collection-nav" aria-label="Shop collections">
  <a href="/shop" aria-current={!current ? 'page' : undefined}>All gear {!unavailable && <span>({total})</span>}</a>
  {visible.map(collection => <a href={canonicalCategoryPath(collection.slug)} aria-current={current === collection.slug ? 'page' : undefined}>{collection.title} {!unavailable && <span>({collection.products.length})</span>}</a>)}
</nav>
<style>
.collection-nav{width:min(70rem,calc(100% - 2rem));margin:2rem auto 0;display:flex;flex-wrap:wrap;gap:.5rem 2rem;border-bottom:1px solid var(--store-line)}
.collection-nav a{display:flex;align-items:center;gap:.4rem;min-height:48px;padding:.5rem 0;color:var(--store-ink);text-decoration:none;border-bottom:3px solid transparent}
.collection-nav a[aria-current]{border-color:var(--store-ink);font-weight:700}
.collection-nav a:hover{text-decoration:underline;text-underline-offset:.25em}
.collection-nav a:focus-visible{outline:3px solid var(--store-focus-ring);outline-offset:3px}
.collection-nav span{font-variant-numeric:tabular-nums;color:var(--store-muted);font-weight:400}
@media(max-width:40rem){.collection-nav{gap:.25rem 1.25rem}}
</style>
