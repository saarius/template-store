---
interface Props { profile: string; currentPath?: string; note?: string }
---
<footer class="brb-footer" data-store-footer>
  <div class="brb-footer__inner">
    <div><a class="brb-footer__brand" href="/">BACKROAD BUM</a><p>For the miles in between.</p></div>
    <nav aria-label="Explore"><h2>Take a look around</h2><a href="/shop">All gear</a><a href="/field-notes">Field notes</a><a href="/search">Search the shop</a></nav>
    <nav aria-label="Policies & Care"><h2>Before you go</h2><a href="/checkout/success" data-last-checkout-link>Your last checkout</a><a href="/test-store">Test-store guide</a><a href="/shipping">Shipping</a><a href="/returns">Returns</a><a href="/dashboard/">The experiment</a></nav>
  </div>
  <div class="brb-footer__bottom">&copy; {new Date().getUTCFullYear()} Backroad Bum <span>Built with EmDash &amp; DinkusKit</span></div>
</footer>
<style>
.brb-footer{margin-top:4rem;background:var(--store-vault-bg);color:var(--store-vault-ink);padding:3rem max(1rem,calc((100vw - 70rem)/2)) 1.25rem}
.brb-footer__inner{display:grid;grid-template-columns:1.6fr 1fr 1fr;gap:2rem}
.brb-footer a{color:inherit;text-decoration:none}.brb-footer a:hover{text-decoration:underline}
.brb-footer__brand{font-family:var(--font-display);font-size:2rem;font-weight:700}
.brb-footer h2{font-family:var(--font-sans);font-size:1rem;margin:.25rem 0 1rem;font-weight:600}
.brb-footer nav a{display:block;width:fit-content;line-height:1.5;margin:.5rem 0;color:var(--store-vault-muted);font-size:.95rem}
.brb-footer p{color:var(--store-vault-muted);margin:.5rem 0}
.brb-footer__bottom{display:flex;justify-content:space-between;flex-wrap:wrap;gap:1rem;padding-top:2rem;margin-top:2rem;border-top:1px solid #547587;font-size:.8rem;color:var(--store-vault-muted)}
@media(max-width:38rem){.brb-footer__inner{grid-template-columns:1fr 1fr}.brb-footer__inner>div{grid-column:1/-1}}
</style>
