---
import type { FieldNote } from './field-notes.js';
interface Props { notes: FieldNote[] }
const { notes } = Astro.props;
---
<footer class="field-note-footer">
  {notes.length > 0 && <nav aria-labelledby="more-notes-heading">
    <h2 id="more-notes-heading">Read another note</h2>
    <ul>{notes.map(note => <li><a href={`/${note.slug}`}>{note.title}</a></li>)}</ul>
  </nav>}
  <div class="field-note-shop">
    <h2>Gear for the good part.</h2>
    <p>A mug for the coffee stop. A tote for the way back. Take a look at the camp gear and roadwear.</p>
    <a href="/shop">Browse all gear</a>
  </div>
</footer>
<style>
.field-note-footer{max-width:48rem;margin-top:var(--space-8);border-top:1px solid var(--color-border);padding-top:var(--space-7)}
.field-note-footer h2{font-size:var(--text-xl);line-height:1.25;margin:0 0 var(--space-4);letter-spacing:-.025em}
.field-note-footer ul{list-style:none;margin:0;padding:0;display:grid;gap:var(--space-2)}
.field-note-footer a{color:var(--store-ink);font-weight:500;text-underline-offset:.2em;display:inline-flex;align-items:center;min-height:44px;padding:.55rem 0}
.field-note-shop{margin-top:var(--space-7);background:var(--store-surface);padding:var(--space-5);border:1px solid var(--color-border);border-radius:var(--radius-panel)}
.field-note-shop p{margin:0 0 .5rem;max-width:42ch}
.field-note-shop h2{margin-bottom:.75rem}
</style>
