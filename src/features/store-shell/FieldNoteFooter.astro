---
import type { FieldNote } from './field-notes.js';
interface Props { notes: FieldNote[] }
const { notes } = Astro.props;
---
<footer class="field-note-footer">
  {notes.length > 0 && <nav aria-labelledby="more-notes-heading">
    <h2 id="more-notes-heading">Read another note</h2>
    <ul>{notes.map(note => <li><a href={`/${note.slug}`}>{note.title}</a></li>)}</ul>
  </nav>}
  <div class="field-note-shop">
    <h2>Gear for the good part.</h2>
    <p>A mug for the coffee stop. A tote for the way back. Take a look at the camp gear and roadwear.</p>
    <a href="/shop">Browse all gear</a>
  </div>
</footer>
<style>
.field-note-footer{max-width:44rem;margin-top:3rem;border-top:1px solid var(--store-line);padding-top:2rem}
.field-note-footer h2{font-size:1.65rem;line-height:1.2;margin:0 0 1rem;letter-spacing:-.025em}
.field-note-footer ul{list-style:none;margin:0;padding:0;display:grid;gap:.25rem}
.field-note-footer a{color:var(--store-ink);font-weight:600;text-underline-offset:.2em;display:inline-block;padding:.55rem 0}
.field-note-shop{margin-top:2rem;background:var(--brb-blue);padding:1.5rem;border-radius:4px}
.field-note-shop p{margin:0 0 .5rem;max-width:42ch}
.field-note-shop h2{margin-bottom:.75rem}
</style>
