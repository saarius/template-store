---
/**
 * Any published CMS page at its own address, such as /about-us
 * (template-cms-pages-and-redirects-20261027). Pages with their own storefront
 * file (/shipping, /returns, the home page) keep it; Astro serves those first.
 */
import { getEmDashEntry, getEmDashCollection, getRequestContext, getEditMeta, type PortableTextBlock } from "emdash";
import FieldNoteFooter from "../features/store-shell/FieldNoteFooter.astro";
import FieldNoteSections from "../features/store-shell/FieldNoteSections.astro";
import FieldNoteBlock from "../features/store-shell/portable-text/FieldNoteBlock.astro";
import { fieldNoteSections } from "../features/store-shell/field-note-sections.js";
import MissingPageContent from "../features/store-shell/MissingPageContent.astro";
import TestStoreActions from "../features/store-shell/TestStoreActions.astro";
import { fieldNote, nextFieldNotes } from "../features/store-shell/field-notes.js";
import { Blocks, PortableText, type BlockValue } from "emdash/ui";
import StoreHeader from "../features/store-shell/StoreHeader.astro";
import ThemeHead from "../features/store-shell/ThemeHead.astro";
import StoreFooter from "../features/store-shell/StoreFooter.astro";
import UnknownBlock from "../features/store-shell/blocks/UnknownBlock.astro";
import { pageLayoutComponents } from "../features/store-shell/blocks/index.js";
import { legacyPortableTextComponents } from "../features/store-shell/portable-text/index.js";
import { STORE_TITLE, readStorefrontProfile } from "../features/store-shell/index.js";
import { canonicalUrl } from "../features/store-shell/structured-data.js";
import "../features/store-shell/global.css";
import "../features/store-shell/field-note-print.css";
import { storeBannerText } from '../features/store-shell/checkout-copy.js';
import { acquireGuestCheckoutAdmission } from '../features/guest-cart/checkout-admission.js';
const checkoutAvailable = Boolean(await acquireGuestCheckoutAdmission({ runtime: Astro.locals.emdash, request: Astro.request }).catch(() => null));

const slug = Astro.params.slug ?? "";
// The home page lives at "/", never at "/home".
const { entry } = slug === "home" ? { entry: null } : await getEmDashEntry("pages", slug);
const data = entry?.data as { title?: string; content?: PortableTextBlock[]; layout?: BlockValue[] } | undefined;
const layout = Array.isArray(data?.layout) ? data.layout : [];
const content = Array.isArray(data?.content) ? data.content : [];
const title = data?.title?.trim() || "Page not found";
const profile = readStorefrontProfile();
const note = layout.length === 0 ? fieldNote(entry) : null;
const context = getRequestContext();
const publicNote = note && !context?.preview && !context?.editMode && !getEditMeta(content) ? note : null;
const journalLink = publicNote ? `/field-notes#journal-${publicNote.slug}` : '/field-notes';
const reading = publicNote ? fieldNoteSections(content) : null;
const textComponents = reading ? { ...legacyPortableTextComponents, block: FieldNoteBlock } : legacyPortableTextComponents;
const testGuide = Boolean(entry && slug === "test-store" && layout.length === 0);
// Continue through the published journal; an optional read must not hide the article.
const relatedNotes = note ? await getEmDashCollection<"pages", Record<string, unknown>>("pages", { status: "published" })
  .then(({ entries }) => nextFieldNotes(entries, note.slug))
  .catch(() => []) : [];
if (!entry) Astro.response.status = 404;
const canonical = entry ? canonicalUrl(`/${slug}`, Astro.site, Astro.url) : null;
---
<!doctype html>
<html lang="en">
  <head>
    <ThemeHead />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    {canonical && <link rel="canonical" href={canonical} />}
    {note?.excerpt && <meta name="description" content={note.excerpt} />}
    {!entry && <meta name="robots" content="noindex" />}
    <title>{title} | {STORE_TITLE}</title>
  </head>
  <body data-storefront-profile={profile} data-field-note-page={note ? '' : undefined}>
    <div class="store-demo-banner" role="status">{storeBannerText(checkoutAvailable)} <a href="/test-store">How to try it</a></div>
    <StoreHeader profile={profile} />
    <main id="main-content" class:list={["cms-page", { "field-note": Boolean(note), "cms-reading": Boolean(note) || testGuide, "cms-page--missing": !entry }]} data-cms-page={entry ? slug : undefined}>
      {entry ? (
        <>
          {note && <><a class="field-note__back" href={journalLink}>Back to field notes</a><p class="field-note__kicker">From the field journal</p></>}
          {layout.length === 0 && <h1 class="cms-page__title">{title}</h1>}
          {reading && <FieldNoteSections sections={reading.sections} />}
          {layout.length > 0 ? (
            <div class="cms-composition" data-cms-composition data-layout="blocks">
              <Blocks value={layout} components={pageLayoutComponents} fallback={UnknownBlock} />
            </div>
          ) : content.length > 0 && (
            <div class="cms-page__body prose" data-cms-page-body>
              <PortableText value={reading?.content ?? content} components={textComponents} />
            </div>
          )}
          {note && <>
            <p class="field-note__print-source">Backroad Bum · Field journal<br />DEMO / TEST STORE — No real charges or shipments.<br /><span>{canonical}</span></p>
            <FieldNoteFooter notes={relatedNotes} />
          </>}
          {testGuide && <TestStoreActions />}
        </>
      ) : (
        <MissingPageContent />
      )}
    </main>
    <StoreFooter profile={profile} />
  </body>
</html>
<style>
  .cms-page{width:min(70rem,calc(100% - 2rem));margin:2.5rem auto 4rem;min-height:60vh;line-height:1.65}
  .cms-page--missing{margin-block:0}
  .cms-page .cms-composition{width:100%}
  .cms-page__title{margin:0 0 1rem;font-size:clamp(2.1rem,5vw,3.4rem);line-height:1.02;letter-spacing:-.025em}
  .cms-page__body{max-width:44rem}
  .cms-page__body :global(h2){margin:1.5rem 0 .5rem;font-size:1.3rem;letter-spacing:-.02em}
  .cms-page__body :global(p){margin:0 0 1rem;color:var(--store-ink)}
  .cms-reading{width:min(48rem,calc(100% - 2.5rem));margin:var(--space-8) auto var(--space-9)}
  .field-note__back{display:inline-flex;align-items:center;min-height:44px;margin-bottom:var(--space-7);color:var(--store-ink);text-underline-offset:.2em}
  .field-note__kicker{font-size:var(--text-sm);color:var(--store-muted);margin:0 0 var(--space-4)}
  .cms-reading .cms-page__title{font-size:var(--editorial-title);line-height:1.15;margin-bottom:var(--space-7);max-width:20ch;text-wrap:balance}
  .cms-reading .cms-page__body{font-size:clamp(1.0625rem,1rem + .2vw,1.125rem);max-width:65ch;line-height:1.75}
  .cms-reading .cms-page__body :global(p){max-width:65ch;margin-bottom:var(--space-5)}
  .cms-reading .cms-page__body :global(h2){margin-top:var(--space-8);margin-bottom:var(--space-4);font-size:var(--text-xl);line-height:1.25}
  .cms-reading .cms-page__body :global(p:first-child){font-family:var(--font-display);font-size:var(--text-xl);font-weight:500;line-height:1.5;color:var(--store-ink);margin-bottom:var(--space-7)}
  .cms-reading .cms-page__body :global(ol),.cms-reading .cms-page__body :global(ul){margin:0 0 1.5rem;padding-inline-start:1.6em}
  .cms-reading .cms-page__body :global(li + li){margin-top:.75rem}
  .field-note .cms-page__body :global(blockquote){margin:var(--space-6) 0;padding:var(--space-4) var(--space-5);border-inline-start:3px solid var(--store-accent);background:var(--store-surface);color:var(--store-ink);font:inherit;overflow-wrap:anywhere}
  .field-note .cms-page__body :global([data-note-section]){scroll-margin-block-start:var(--space-7)}
  .field-note .cms-page__body :global([data-note-section]:focus-visible){outline:3px solid var(--store-accent);outline-offset:6px;border-radius:var(--radius-control)}
  .cms-reading .cms-page__body :global(a){color:var(--store-ink);text-decoration:underline;text-underline-offset:.18em}
  .cms-reading .cms-page__body :global(a:hover){text-decoration-thickness:2px}
</style>
