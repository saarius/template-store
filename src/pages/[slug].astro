---
/**
 * Any published CMS page at its own address, such as /about-us
 * (template-cms-pages-and-redirects-20261027). Pages with their own storefront
 * file (/shipping, /returns, the home page) keep it; Astro serves those first.
 */
import { getEmDashEntry, getEmDashCollection, type PortableTextBlock } from "emdash";
import FieldNoteFooter from "../features/store-shell/FieldNoteFooter.astro";
import MissingPageContent from "../features/store-shell/MissingPageContent.astro";
import TestStoreActions from "../features/store-shell/TestStoreActions.astro";
import { fieldNote, fieldNotes } from "../features/store-shell/field-notes.js";
import { Blocks, PortableText, type BlockValue } from "emdash/ui";
import StoreHeader from "../features/store-shell/StoreHeader.astro";
import StoreFooter from "../features/store-shell/StoreFooter.astro";
import UnknownBlock from "../features/store-shell/blocks/UnknownBlock.astro";
import { pageLayoutComponents } from "../features/store-shell/blocks/index.js";
import { legacyPortableTextComponents } from "../features/store-shell/portable-text/index.js";
import { STORE_TITLE, readStorefrontProfile } from "../features/store-shell/index.js";
import { canonicalUrl } from "../features/store-shell/structured-data.js";
import "../features/store-shell/global.css";
import { storeBannerText } from '../features/store-shell/checkout-copy.js';
import { acquireGuestCheckoutAdmission } from '../features/guest-cart/checkout-admission.js';
const checkoutAvailable = Boolean(await acquireGuestCheckoutAdmission({ runtime: Astro.locals.emdash, request: Astro.request }).catch(() => null));

const slug = Astro.params.slug ?? "";
// The home page lives at "/", never at "/home".
const { entry } = slug === "home" ? { entry: null } : await getEmDashEntry("pages", slug);
const data = entry?.data as { title?: string; content?: PortableTextBlock[]; layout?: BlockValue[] } | undefined;
const layout = Array.isArray(data?.layout) ? data.layout : [];
const content = Array.isArray(data?.content) ? data.content : [];
const title = data?.title?.trim() || "Page not found";
const profile = readStorefrontProfile();
const note = layout.length === 0 ? fieldNote(entry) : null;
const testGuide = Boolean(entry && slug === "test-store" && layout.length === 0);
// Related reading is optional; a failed collection read must not hide the article.
const relatedNotes = note ? await getEmDashCollection<"pages", Record<string, unknown>>("pages", { status: "published" })
  .then(({ entries }) => fieldNotes(entries).filter(item => item.slug !== note.slug).slice(0, 2))
  .catch(() => []) : [];
if (!entry) Astro.response.status = 404;
const canonical = entry ? canonicalUrl(`/${slug}`, Astro.site, Astro.url) : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    {canonical && <link rel="canonical" href={canonical} />}
    {note?.excerpt && <meta name="description" content={note.excerpt} />}
    {!entry && <meta name="robots" content="noindex" />}
    <title>{title} | {STORE_TITLE}</title>
  </head>
  <body data-storefront-profile={profile}>
    <div class="store-demo-banner" role="status">{storeBannerText(checkoutAvailable)} <a href="/test-store">How to try it</a></div>
    <StoreHeader profile={profile} />
    <main id="main-content" class:list={["cms-page", { "field-note": Boolean(note), "cms-reading": Boolean(note) || testGuide, "cms-page--missing": !entry }]} data-cms-page={entry ? slug : undefined}>
      {entry ? (
        <>
          {note && <a class="field-note__back" href="/field-notes">Back to field notes</a>}
          {layout.length === 0 && <h1 class="cms-page__title">{title}</h1>}
          {layout.length > 0 ? (
            <div class="cms-composition" data-cms-composition data-layout="blocks">
              <Blocks value={layout} components={pageLayoutComponents} fallback={UnknownBlock} />
            </div>
          ) : content.length > 0 && (
            <div class="cms-page__body prose" data-cms-page-body>
              <PortableText value={content} components={legacyPortableTextComponents} />
            </div>
          )}
          {note && <FieldNoteFooter notes={relatedNotes} />}
          {testGuide && <TestStoreActions />}
        </>
      ) : (
        <MissingPageContent />
      )}
    </main>
    <StoreFooter profile={profile} />
  </body>
</html>
<style>
  .cms-page{width:min(70rem,calc(100% - 2rem));margin:2.5rem auto 4rem;min-height:60vh;line-height:1.65}
  .cms-page--missing{margin-block:0}
  .cms-page .cms-composition{width:100%}
  .cms-page__title{margin:0 0 1rem;font-size:clamp(2.1rem,5vw,3.4rem);line-height:1.02;letter-spacing:-.025em}
  .cms-page__body{max-width:44rem}
  .cms-page__body :global(h2){margin:1.5rem 0 .5rem;font-size:1.3rem;letter-spacing:-.02em}
  .cms-page__body :global(p){margin:0 0 1rem;color:var(--store-ink)}
  .cms-reading{max-width:52rem}
  .field-note__back{display:inline-block;margin-bottom:1.5rem;padding:.5rem 0;color:var(--store-ink);text-underline-offset:.2em}
  .cms-reading .cms-page__title{max-width:20ch;text-wrap:balance}
  .cms-reading .cms-page__body{font-size:1.0625rem;max-width:68ch}
  .cms-reading .cms-page__body :global(h2){margin-top:2.25rem;margin-bottom:.65rem;font-size:1.65rem;line-height:1.2}
  .cms-reading .cms-page__body :global(p:first-child){font-size:1.15rem;color:var(--store-muted);margin-bottom:2rem}
</style>
