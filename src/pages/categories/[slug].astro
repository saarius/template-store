---
import BackroadPage from '../../features/store-shell/BackroadPage.astro';
import CollectionNav from '../../features/store-shell/CollectionNav.astro';
import MissingPageContent from '../../features/store-shell/MissingPageContent.astro';
import CommerceCatalog from '../../features/commerce-catalog/CommerceCatalog.astro';
import { getEmDashCollection } from 'emdash';
import { readCommerceCatalog } from '../../features/commerce-catalog/index.js';
import { acquireGuestCheckoutAdmission } from '../../features/guest-cart/checkout-admission.js';
import { hydrateProductCollectionMembership } from '../../features/store-shell/product-routes.js';
import { shopCollections } from '../../features/store-shell/backroad-collections.js';

const entries = await getEmDashCollection<'products', Record<string, unknown>>('products', { status: 'published' });
const categories = await getEmDashCollection<'categories', Record<string, unknown>>('categories', { status: 'published' });
let unavailable = false;
const products = await readCommerceCatalog({ runtime: Astro.locals.emdash, request: Astro.request }).catch(() => { unavailable = true; return []; });
const { groups, paths } = shopCollections(await hydrateProductCollectionMembership(entries.entries), categories.entries, products);
const category = groups.find(group => group.slug === Astro.params.slug);
if (!category) Astro.response.status = 404;
const checkoutAvailable = Boolean(await acquireGuestCheckoutAdmission({ runtime: Astro.locals.emdash, request: Astro.request }).catch(() => null));
---
<BackroadPage title={category?.title ?? 'Collection not found'} description={category?.description || 'Everyday gear for a slow weekend away.'} noindex={!category}>
  {category ? <header class="brb-page collection-intro">
    <nav aria-label="Breadcrumb"><a href="/shop">Shop</a><span aria-hidden="true">/</span><span aria-current="page">{category?.title ?? 'Not found'}</span></nav>
    <h1>{category?.title ?? 'That collection isn’t here.'}</h1>
    {category?.description && <p class="lead">{category.description}</p>}
  </header> : <div class="missing-collection"><MissingPageContent title="That collection isn’t here." description="It may have moved or is no longer published. Search the store or browse the current gear below." /></div>}
  {category && <>
    <CollectionNav collections={groups} total={products.length} current={category.slug} unavailable={unavailable} />
    <CommerceCatalog products={category.products} productPaths={paths} unavailable={unavailable} checkoutAvailable={checkoutAvailable} heading="In this collection" emptyMessage="No gear in this collection right now. Browse all gear above for something to take along." />
  </>}
</BackroadPage>
<style>
.missing-collection{width:min(70rem,calc(100% - 2rem));margin-inline:auto}
.collection-intro{margin-bottom:1.5rem;min-height:12rem}
.collection-intro nav{display:flex;flex-wrap:wrap;gap:.75rem;color:var(--store-muted);margin-bottom:1.5rem}
.collection-intro nav a{color:inherit;text-underline-offset:.2em}
.collection-intro h1{margin-top:0}
</style>
