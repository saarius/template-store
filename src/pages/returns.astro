---
import { getEmDashEntry, getSection, type PortableTextBlock } from "emdash";
import StoreHeader from "../features/store-shell/StoreHeader.astro";
import ThemeHead from "../features/store-shell/ThemeHead.astro";
import StoreFooter from "../features/store-shell/StoreFooter.astro";
import PolicyContent from "../features/store-shell/PolicyContent.astro";
import {
  POLICY_SUPPORT_SECTION_SLUG,
  STORE_TITLE,
  readStorefrontProfile,
} from "../features/store-shell/index.js";
import { canonicalUrl, jsonLdScript, storeReturnPolicyJsonLd } from "../features/store-shell/structured-data.js";
import "../features/store-shell/global.css";

// Published EmDash prose owns the policy; no structured return terms are invented.
const { entry, isPreview } = await getEmDashEntry("pages", "returns");
const supportSection = await getSection(POLICY_SUPPORT_SECTION_SLUG).catch(() => null);
const profile = readStorefrontProfile();
const title = entry?.data?.title ?? "Returns";
const content = Array.isArray(entry?.data?.content) ? (entry.data.content as PortableTextBlock[]) : [];
const intro = (entry?.data as { intro?: string } | undefined)?.intro;
const canonical = canonicalUrl("/returns", Astro.site, Astro.url);
// A published returns page names itself as the policy, by link only.
const returnPolicyJsonLd = content.length > 0 && !isPreview
  ? storeReturnPolicyJsonLd({ storeName: STORE_TITLE, storeUrl: canonicalUrl("/", Astro.site, Astro.url), returnsUrl: canonical })
  : null;
---
<!doctype html>
<html lang="en">
  <head><ThemeHead /><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><link rel="canonical" href={canonical} /><title>{title} | {STORE_TITLE}</title>{returnPolicyJsonLd && <script type="application/ld+json" set:html={jsonLdScript(returnPolicyJsonLd)} />}</head>
  <body data-storefront-profile={profile}>
    <StoreHeader profile={profile} />
    <PolicyContent kind="returns" title={title} intro={intro} content={content} supportContent={supportSection?.content} />
    <StoreFooter profile={profile} />
  </body>
</html>
