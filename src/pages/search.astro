---
import { getEmDashCollection, getRequestContext, search } from 'emdash';
import BackroadPage from '../features/store-shell/BackroadPage.astro';
import { loadVisibleStorefrontProductSlugs } from '../features/store-shell/search-visibility.js';
import { loadStoreSearch, type StoreSearchHit } from '../features/store-shell/store-search.js';
import { fieldNotes } from '../features/store-shell/field-notes.js';

const results = await loadStoreSearch(Astro.url.searchParams.get('q') ?? '', {
  search: async query => (await search(query, { collections: ['products', 'categories', 'pages'], status: 'published', limit: 20 })).items as StoreSearchHit[] ?? [],
  visibleProducts: () => loadVisibleStorefrontProductSlugs({ runtime: Astro.locals.emdash, request: Astro.request }, process.env, { throwOnUnavailable: true }),
  fieldNotePreviews: async slugs => {
    // The CMS loader intentionally serves drafts in editor/preview contexts.
    // Search is published-only, so omit optional previews in those contexts.
    const context = getRequestContext();
    if (context?.preview || context?.editMode) return new Map();
    const { entries } = await getEmDashCollection<'pages', Record<string, unknown>>('pages', {
      status: 'published', where: { slug: [...slugs] }, limit: 20,
    });
    return new Map(fieldNotes(entries).map(note => [note.slug, note.excerpt]));
  },
});
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, follow');
if (results.state === 'unavailable') Astro.response.status = 503;
---
<BackroadPage title={results.query ? `Search: ${results.query}` : 'Search'} description="Find Backroad Bum gear, collections and field notes.">
  <section class="brb-page search-page" data-search-page>
    <p class="search-kicker">Gear · Collections · Field notes</p>
    <h1>Search Backroad Bum</h1>
    <p class="lead">Find a piece of gear, a slower weekend read or a collection for the road.</p>
    <form method="get" action="/search" role="search" aria-label="Search Backroad Bum" data-search-form>
      <label for="store-search-query">What are you looking for?</label>
      <div class="search-controls">
        <input id="store-search-query" type="search" name="q" value={results.query} minlength="2" maxlength="120" aria-describedby="search-help" placeholder="Try mug, fleece or wet gear" />
        <button type="submit">Search</button>
      </div>
      <p id="search-help" class="search-help">Use at least two characters. Searches include gear, collections, field notes and guides.</p>
    </form>

    {results.state === 'unavailable' ? <section class="search-message" role="alert" data-search-unavailable>
      <h2>Search is taking a break.</h2>
      <p>We couldn’t load the results. Your search is still above—try it again, or <a href="/shop">browse all gear</a>.</p>
    </section> : results.state === 'idle' || results.state === 'short' ? <section class="search-message" data-search-prompt>
      <h2>{results.state === 'short' ? 'A little more to go on.' : 'A good place to start.'}</h2>
      <p>{results.state === 'short' ? 'Enter at least two characters to search.' : 'Try a product name or something you’re planning for the weekend.'}</p>
      <nav class="search-ideas" aria-label="Search ideas"><a href="/search?q=mug">Mug</a><a href="/search?q=fleece">Fleece</a><a href="/search?q=wet+gear">Wet gear</a></nav>
    </section> : <section class="search-matches" aria-labelledby="search-results-title" data-search-results>
      <h2 id="search-results-title">Results for <q>{results.query}</q></h2>
      {results.state === 'empty' ? <div data-search-empty>
        <p>No matches this time. Try a shorter phrase, check the spelling or <a href="/shop">browse all gear</a>.</p>
        <p>Looking for a read instead? <a href="/field-notes">Open the field notes</a>.</p>
      </div> : <>
        <p class="search-summary" data-search-results-count>{results.count} {results.count === 1 ? 'result' : 'results'}{results.limited ? ' shown. Try a more specific search to narrow the list.' : '.'}</p>
        {results.groups.map(group => <section class="search-group" aria-label={group.label}>
          <h3>{group.label}</h3>
          <ul>{group.items.map(item => <li>
            <a href={item.href}>{item.title}</a>
            {item.parts.length > 0 && <p>{item.parts.map(part => part.highlighted ? <mark>{part.text}</mark> : part.text)}</p>}
          </li>)}</ul>
        </section>)}
      </>}
    </section>}
    <nav class="search-browse" aria-label="Keep exploring"><a href="/shop">All gear</a><a href="/field-notes">Field notes</a><a href="/test-store">Test-store guide</a></nav>
  </section>
</BackroadPage>
<style>
  .search-page{max-width:56rem;min-height:55vh}
  .search-kicker{font-size:var(--text-sm);color:var(--store-muted);margin:0 0 var(--space-3)}
  .search-page h1{font-size:var(--app-title)}
  .search-page .lead{font-size:1rem;margin-bottom:var(--space-7)}
  .search-page a{color:inherit}
  form{max-width:48rem}
  label{display:block;font-weight:600;margin-bottom:.5rem}
  .search-controls{display:flex;gap:.75rem;align-items:stretch}
  input{min-width:0;flex:1;padding:.75rem 1rem;min-height:48px;border:1px solid var(--store-ink-border);border-radius:var(--radius-control);background:var(--store-surface);color:var(--store-ink);font:inherit}
  input::placeholder{color:var(--store-muted);opacity:1}
  input:hover{border-color:var(--store-accent)}
  input:user-invalid{border-color:var(--color-danger)}
  button{padding:.7rem 1.5rem;min-height:48px;border:0;border-radius:var(--radius-control);background:var(--store-accent);color:var(--store-accent-ink);font:inherit;font-weight:600;cursor:pointer}
  button:hover{background:color-mix(in oklch,var(--store-accent) 88%,var(--store-ink))}
  .search-help,.search-summary{color:var(--store-muted)}
  .search-help{max-width:65ch;margin:.75rem 0 0}
  .search-message,.search-matches{margin-top:var(--space-8);border-top:1px solid var(--color-border);padding-top:var(--space-7)}
  .search-page .search-message h2,.search-page .search-matches>h2{font-size:var(--text-xl);margin:0 0 var(--space-3);overflow-wrap:anywhere}
  .search-message p,.search-matches p{max-width:65ch}
  .search-ideas,.search-browse{display:flex;flex-wrap:wrap;gap:.75rem 1.5rem}
  .search-ideas{margin-top:1.25rem}
  .search-ideas a,.search-browse a{display:inline-flex;align-items:center;min-height:44px;padding:.5rem 0}
  .search-ideas a{padding:.5rem 1rem;border:1px solid var(--store-ink-border);border-radius:var(--radius-control);background:var(--store-surface);text-decoration:none}
  .search-ideas a:hover{background:var(--store-surface-subtle)}
  .search-browse{margin-top:var(--space-8);padding-top:var(--space-4);border-top:1px solid var(--color-border)}
  .search-group{margin-top:var(--space-7)}
  .search-group h3{font-family:var(--font-sans);font-size:var(--text-sm);font-weight:600;line-height:1.4;margin:0 0 var(--space-4);color:var(--store-muted)}
  .search-group ul{list-style:none;margin:0;padding:0;display:grid;gap:var(--space-4)}
  .search-group li{position:relative;padding:var(--space-5);border:1px solid var(--color-border);border-radius:var(--radius-card);background:var(--store-surface)}
  .search-group li:hover{border-color:var(--store-ink-border)}
  .search-group li>a{display:inline-flex;align-items:center;min-height:44px;font-family:var(--font-display);font-size:var(--text-lg);font-weight:500;overflow-wrap:anywhere}
  .search-group li p{margin:var(--space-2) 0 0;color:var(--store-muted);overflow-wrap:anywhere}
  mark{background:var(--color-primary-subtle);color:var(--store-ink)}
  @media(max-width:30rem){.search-controls{flex-direction:column}.search-controls button{align-self:flex-start}}
</style>
