---
import StoreFooter from "../../features/store-shell/StoreFooter.astro";
import StoreHeader from "../../features/store-shell/StoreHeader.astro";
import { getEmDashCollection, type PortableTextBlock } from "emdash";
import { Blocks, PortableText, type BlockValue } from "emdash/ui";
import { acquireGuestCheckoutAdmission } from "../../features/guest-cart/checkout-admission.js";
import { canAddCommerceProductToCart } from "../../features/guest-cart/index.js";
import { linkedProductPurchasable, storeBannerText } from "../../features/store-shell/checkout-copy.js";
import { AddToCart } from "../../features/guest-cart/ui.ts";
import ProductGallery from "../../features/commerce-catalog/ProductGallery.astro";
import RelatedGear from "../../features/store-shell/RelatedGear.astro";
import MissingPageContent from "../../features/store-shell/MissingPageContent.astro";
import { productDetailComponents } from "../../features/store-shell/blocks/index.js";
import UnknownBlock from "../../features/store-shell/blocks/UnknownBlock.astro";
import { legacyPortableTextComponents } from "../../features/store-shell/portable-text/index.js";
import { readInstalledCommerceProduct, readInstalledCommerceProductByPage } from "../../features/commerce-catalog/installed.js";
import { buildProductPreviewJsonLd } from "@dinkuskit/commerce/features/structured-data";
import { linkedProductJsonLd } from "../../features/store-shell/linked-product-jsonld.js";
import { allowsProductJsonLd, canonicalUrl, jsonLdScript } from "../../features/store-shell/structured-data.js";
import { availabilityLabels } from "../../features/commerce-catalog/index.js";
import { demoPlaceholderImage } from "../../features/playground/demo-products.js";
import { variantPickerView, NO_OFFER_JSON_LD_KEY, type VariantPickerMember } from "../../features/store-shell/variant-picker.js";
import { productSelection } from "../../features/store-shell/product-selection.js";
import { productIdentifiers } from "../../features/store-shell/product-identifiers.js";
import { STORE_TITLE, categoryPath, loadStorefrontRouteContext, productPath } from "../../features/store-shell/index.js";
import { hydrateProductCollectionMembership, productPageOffersCart, readProductEntries } from "../../features/store-shell/product-routes.js";
import { leftCommerceCatalog } from "../../features/store-shell/merch-catalog.js";
import { playgroundCheckoutAdmission, playgroundCheckoutConfigured, playgroundEnvOf, showsSandboxCheckoutNotice } from "../../features/playground-checkout/index.js";
import { isDemoCatalogProfile } from "../../features/playground/demo-products.js";
import "../../features/store-shell/global.css";

const productCollection = await getEmDashCollection<"products", Record<string, unknown>>("products", { status: "published" });
const products = { ...productCollection, entries: await hydrateProductCollectionMembership(productCollection.entries) };
const categoryEntries = await getEmDashCollection<"categories", Record<string, unknown>>("categories", { status: "published" });
// Commerce keeps which page sells each product (template-no-commerce-box-20261029): this page's product is
// found by the page's entry id; the store never reads an older store's field (template-drop-older-store-box-20261101).
const pageEntry = products.entries.find((entry) => productPath(entry.id) === Astro.url.pathname);
const pageEntryId = typeof pageEntry?.data.id === "string" ? pageEntry.data.id : "";
let pageLookupFailed = false;
const pageProduct = pageEntryId
  ? await readInstalledCommerceProductByPage(pageEntryId, { runtime: Astro.locals.emdash, request: Astro.request })
    .catch(() => { pageLookupFailed = true; return null; })
  : null;
const productLinks = readProductEntries(products.entries, categoryEntries.entries,
  pageProduct ? new Map([[pageEntryId, pageProduct.id]]) : undefined);
const validEntries = products.entries.filter((entry) => productLinks.products.some((product) => product.id === entry.id));
const { profile, demonstrations, collections } = await loadStorefrontRouteContext(validEntries, categoryEntries.entries);
const linked = productLinks.products.find((candidate) => productPath(candidate.id) === Astro.url.pathname);
const linkedSource = linked?.commerceItemId === "dinkus-template-managed-product"
  ? "managed" as const
  : linked?.commerceItemId === "dinkus-template-unmanaged-product"
    ? "unmanaged" as const
    : "preview" as const;
const item = collections.flatMap((group) => group.items).find((candidate) => productPath(candidate.id) === Astro.url.pathname)
  ?? (linked && {
    ...linked,
    category: "",
    availabilitySource: linkedSource,
  });
const category = linked?.categorySlugs[0]
  ? collections.find((group) => group.slug === linked.categorySlugs[0])
  : undefined;
if (!item) Astro.response.status = 404;
// The page's own words: a rich summary beside the price and optional sections
// below it (template-rich-product-page-20261027). Price and stock stay Commerce's.
const entryData = products.entries.find((entry) => entry.id === item?.id)?.data ?? {};
const summary = Array.isArray(entryData.summary) && entryData.summary.length ? entryData.summary as PortableTextBlock[] : null;
const details = Array.isArray(entryData.details) && entryData.details.length ? entryData.details as BlockValue[] : null;
const illustrationSrc = item?.illustration ? `/merch/${item.illustration}.svg` : null;
let lookupUnavailable = false;
let linkedProduct = pageProduct;
// Shipping pages always resolve Commerce; other profiles resolve plain linked
// entries (e.g. seeded demo products) and fall back to preview on failure.
if (item && !linkedProduct && (profile === "shipping" || item.availabilitySource === "preview")) {
  try {
    linkedProduct = await readInstalledCommerceProduct(
      (productLinks.products.find((product) => product.id === item.id)?.commerceItemId) ?? "",
      { runtime: Astro.locals.emdash, request: Astro.request },
    );
    // A product Commerce sells on another page is not this page's.
    if (linkedProduct?.page && linkedProduct.page !== pageEntryId) linkedProduct = null;
  } catch {
    lookupUnavailable = profile === "shipping";
  }
}
if (item && profile === "shipping" && item.availabilitySource !== "preview") {
  Astro.response.status = lookupUnavailable ? 503 : linkedProduct ? 200 : 404;
}
// A shipping store's page whose Commerce product left the catalog (archived)
// is gone for shoppers, like Shopify and WooCommerce: a 404 that says so.
const linkedItemId = item ? productLinks.products.find((product) => product.id === item.id)?.commerceItemId ?? "" : "";
// A published page Commerce lists no product for is gone for shoppers the same way.
const unlinkedPage = Boolean(pageEntry) && !linked && productLinks.unlinked.includes(pageEntry!.id);
if (unlinkedPage && profile === "shipping" && pageLookupFailed) {
  lookupUnavailable = true;
  Astro.response.status = 503;
}
const noLongerAvailable = profile === "shipping" && !lookupUnavailable && !linkedProduct &&
  (unlinkedPage || (Boolean(item) && item?.availabilitySource === "preview" && leftCommerceCatalog(linkedItemId, false)));
if (noLongerAvailable) Astro.response.status = 404;
// The playground and demo profile offer cart + sandbox checkout only when
// DINKUS_CHECKOUT_ENABLED is on; other proof profiles never do.
const isPlayground = Boolean((Astro.locals as { __playgroundDb?: unknown }).__playgroundDb);
const isDemo = isDemoCatalogProfile();
const checkoutEnabled = playgroundCheckoutConfigured(playgroundEnvOf(Astro.locals));
const offersCart = productPageOffersCart({ profile, isPlayground, isDemo, checkoutEnabled });
const sandboxCheckout = showsSandboxCheckoutNotice({ profile, isPlayground, isDemo, checkoutEnabled });
const variants = linkedProduct?.variants ?? [];
const selection = productSelection(variants, Astro.url.searchParams);
const selectedVariant = selection.member;
const identifiers = linkedProduct ? productIdentifiers(linkedProduct, selectedVariant) : null;
// One picker per option (Color, then Size), like Shopify or WooCommerce
// product pages. The browser matches the picked values to one member.
const variantOptions = [...new Set(variants.flatMap((member) => member.selections.map(([option]) => option)))]
  .map((label) => ({
    label,
    values: [...new Set(variants.flatMap((member) => member.selections.filter(([option]) => option === label).map(([, value]) => value)))],
  }));
const selectedValue = (option: string) => selectedVariant?.selections.find(([name]) => name === option)?.[1];
const variantMembers: VariantPickerMember[] = variants.map((member) => ({
  id: member.id,
  ...(member.sku ? { sku: member.sku } : {}),
  values: Object.fromEntries(member.selections),
  price: member.priceText,
  availability: member.availability.status,
  status: availabilityLabels[member.availability.status] ?? "Availability unavailable",
  sellable: member.availability.sellable,
}));
const initialPicker = variantPickerView(variantMembers, Object.fromEntries(selectedVariant?.selections ?? []));
const cartProduct = linkedProduct && variants.length
  ? { ...linkedProduct, id: selectedVariant?.id ?? linkedProduct.id,
    availability: selectedVariant ? { ...selectedVariant.availability, listable: true } : { ...linkedProduct.availability, sellable: false } }
  : linkedProduct;
const linkedStatus = selectedVariant?.availability.status ?? linkedProduct?.availability.status;
// A configured playground admits its sandbox checkout, as the cart page does.
const checkoutAvailable = Boolean(playgroundCheckoutAdmission(isPlayground, playgroundCheckoutConfigured(playgroundEnvOf(Astro.locals)))) ||
  Boolean(await acquireGuestCheckoutAdmission({
    runtime: Astro.locals.emdash,
    request: Astro.request,
  }).catch(() => null));
// A Commerce-linked product on a shipping store says nothing extra when it can
// be bought; the notice appears only when it really cannot.
const purchasable = Boolean(cartProduct) && linkedProductPurchasable({
  offersCart,
  checkoutAvailable,
  sellable: cartProduct ? canAddCommerceProductToCart(cartProduct) : false,
});
// Shoppers see the linked Commerce product's name, which publishing the page
// sets from its title (template-page-title-is-name-20261026), so the heading,
// cart and orders agree.
const productName = linkedProduct?.name.trim() || item?.title;
const managed = item?.availabilitySource === "managed" ? demonstrations?.managed ?? null : null;
const unmanaged = item?.availabilitySource === "unmanaged" ? demonstrations?.unmanaged ?? null : null;
const status = selection.stale ? "Choose an option" : linkedStatus ? availabilityLabels[linkedStatus] ?? "Availability unavailable" : managed ? `${managed.inventory.available} available` : unmanaged ? ({
  "in-stock": "In stock", "out-of-stock": "Out of stock", "available-on-backorder": "Available on backorder",
  "availability-unavailable": "Availability unavailable", "low-stock": "Low stock",
} as Record<string, string>)[unmanaged.storefront.status] ?? "Availability unavailable" : "Preview only · not purchasable";
const productCanonical = item
  ? canonicalUrl(`/products/${item.id}`, Astro.site, Astro.url)
  : "";
// Produce every selectable block on the server through the Commerce builder.
// The browser only selects a prepared block; it never recalculates an Offer.
const selectedProductJsonLd = (variant: (typeof variants)[number] | null) => {
  if (!linkedProduct || !item || !productName) return null;
  if (variants.length && !variant) return buildProductPreviewJsonLd({
    url: productCanonical, name: productName,
    ...(item.description ? { description: item.description } : {}),
  });
  return linkedProductJsonLd(linkedProduct, {
    url: productCanonical,
    name: productName,
    ...(item.description ? { description: item.description } : {}),
  }, variant);
};
// Editorial pages use the preview builder. Unavailable routes emit no data.
const productJsonLd = allowsProductJsonLd(Astro.response.status ?? 200) && item && productName &&
  (item.availabilitySource === "preview" || !lookupUnavailable) &&
  !noLongerAvailable
  ? linkedProduct
    ? selectedProductJsonLd(selectedVariant)
    : buildProductPreviewJsonLd({
      url: productCanonical,
      name: productName,
      ...(item.description ? { description: item.description } : {}),
      ...(illustrationSrc ? { images: [new URL(illustrationSrc, productCanonical).href] } : {}),
    })
  : null;
// A picked combination with no member shows Product facts without an Offer.
const variantJsonLd = productJsonLd && linkedProduct && item && productName && variants.length
  ? {
    ...Object.fromEntries(variants.map((variant) => [variant.id, selectedProductJsonLd(variant)])),
    [NO_OFFER_JSON_LD_KEY]: buildProductPreviewJsonLd({
      url: productCanonical,
      name: productName,
      ...(item.description ? { description: item.description } : {}),
    }),
  }
  : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={noLongerAvailable ? "This product is no longer available." : item?.description ?? "Product not found."} />
    {Astro.response.status === 404 ? <meta name="robots" content="noindex, follow" /> : item && <link rel="canonical" href={productCanonical} />}
    <title>{noLongerAvailable ? `No longer available | ${STORE_TITLE}` : item ? `${productName} | ${STORE_TITLE}` : `Product not found | ${STORE_TITLE}`}</title>
    {productJsonLd && <script type="application/ld+json" data-product-jsonld set:html={jsonLdScript(productJsonLd)} />}
    {variantJsonLd && <script type="application/json" data-variant-product-jsonld set:html={jsonLdScript(variantJsonLd)} />}
  </head>
  <body data-storefront-profile={profile}>
    <div class="store-demo-banner" data-store-demo-banner data-checkout-available={String(checkoutAvailable)} role="status">{storeBannerText(checkoutAvailable)}</div>
    <StoreHeader profile={profile} />
    <main id="main-content" class="product-page">
    <nav class="browse-breadcrumb" aria-label="Breadcrumb"><a href="/shop">Shop</a><span aria-hidden="true">/</span>{category && <><a href={categoryPath(category.slug)}>{category.name}</a><span aria-hidden="true">/</span></>}<span aria-current="page">{noLongerAvailable ? "No longer available" : productName ?? "Not found"}</span></nav>
      {noLongerAvailable ? <section class="product-removed" data-product-removed><h1>This product is no longer available</h1><p>It has been removed from the shop.</p><a href="/">Browse the shop</a></section> : item ? (<>
        <article class="product-detail" data-product-page={item.id} data-product-source={item.availabilitySource} data-commerce-item={linkedProduct?.id}>
            {linkedProduct ? <ProductGallery image={linkedProduct.image} gallery={linkedProduct.gallery} productId={linkedProduct.id} fallbackSrc={demoPlaceholderImage(linkedProduct.sku, item.id)} fallbackAlt={`${productName} placeholder image`} stageClass={["product-detail__visual", item.illustration && `product-detail__visual--${item.illustration}`].filter(Boolean).join(" ")} /> : (
              <div class:list={["product-detail__visual", item.illustration && `product-detail__visual--${item.illustration}`]} data-product-stage-visual>
                {illustrationSrc ? <img src={illustrationSrc} alt={`${item.title} illustration`} width="640" height="480" /> : <p class="product-detail__no-image" data-product-image-placeholder={item.id}>No image</p>}
              </div>
            )}
          <div class="product-detail__body">
            <h1>{productName}</h1>
            {summary ? <div class="product-detail__summary" data-product-summary><PortableText value={summary} components={legacyPortableTextComponents} /></div> : <p class="product-detail__description">{item.description}</p>}
            {identifiers && <p class="product-detail__identifier" data-product-sku={identifiers.sku ?? ""} hidden={!identifiers.sku}>SKU {identifiers.sku}</p>}
            {identifiers?.gtin && <p class="product-detail__identifier" data-product-gtin={identifiers.gtin}>GTIN {identifiers.gtin}</p>}
            {identifiers?.mpn && <p class="product-detail__identifier" data-product-mpn={identifiers.mpn}>MPN {identifiers.mpn}</p>}
            {linkedProduct?.brand && <p class="product-detail__identifier" data-product-brand={linkedProduct.brand}>Brand {linkedProduct.brand}</p>}
            {linkedProduct && <p class="product-detail__price" data-product-price hidden={selection.stale}>{linkedProduct.price.saleText ? <><s data-regular-price>{linkedProduct.price.regularText}</s> <strong data-sale-price>{linkedProduct.price.saleText}</strong></> : <strong data-regular-price data-variant-price>{selectedVariant?.priceText ?? linkedProduct.price.regularText}</strong>}</p>}
            {selection.stale && <p class="product-detail__notice" data-product-selection-notice role="status">That saved option is no longer available. Choose from the options below before adding to your cart.</p>}
            {variantOptions.map((option, index) => <fieldset class="product-variants" data-product-variants data-variant-option={option.label}>
              <legend>{option.label}</legend>
              {option.values.map((value) => <label class="product-variant">
                <input type="radio" name={`variant-option-${index}`} value={value} checked={value === selectedValue(option.label)}
                  data-variant-choice data-variant-option={option.label}
                  data-variant-sold-out={String(initialPicker.soldOut[option.label]?.[value] ?? true)} />
                <span>{value}</span><span class="product-variant__sold-out"> (sold out)</span>
              </label>)}
            </fieldset>)}
            {variantMembers.length > 0 && <>
              <script type="application/json" data-variant-members set:html={jsonLdScript(variantMembers)} />
              <noscript>
                <form method="get" action={productCanonical} class="product-options-fallback" data-product-options-fallback>
                  <label for="product-option">View a product option</label>
                  <p>Load an option to see its current price and availability. Saving items to your cart needs JavaScript.</p>
                  <select id="product-option" name="item" required>
                    <option value="" disabled selected={!selectedVariant}>Choose an option</option>
                    {variantMembers.map(member => <option value={member.id} selected={member.id === selectedVariant?.id}>{Object.entries(member.values).map(([label, value]) => `${label}: ${value}`).join(' / ')}</option>)}
                  </select>
                  <button type="submit">View option</button>
                </form>
              </noscript>
            </>}
            {managed && <p class="product-detail__price" data-product-price><strong data-regular-price>{managed.price.regularText}</strong></p>}
            {unmanaged && <p class="product-detail__price" data-product-price>{unmanaged.price.saleText ? <><s data-regular-price>{unmanaged.price.regularText}</s> <strong data-sale-price>{unmanaged.price.saleText}</strong></> : <strong data-regular-price>{unmanaged.price.regularText}</strong>}</p>}
            <p class="product-detail__status" data-product-status data-availability-status={linkedStatus ?? unmanaged?.storefront.status}>{status}</p>
            {cartProduct && offersCart && <AddToCart product={cartProduct} variants={variants} selectionRequired={selection.stale} />}
            {lookupUnavailable ? <p class="product-detail__notice" role="status">Product availability is temporarily unavailable. Please try again.</p> : sandboxCheckout ? <p class="product-detail__notice" data-sandbox-checkout-available>Test-mode checkout. No real charges.</p> : linkedProduct && profile !== "shipping" ? <p class="product-detail__notice" data-checkout-unavailable>{offersCart ? "Demo product. Checkout is unavailable." : "Demo product. Cart and checkout are unavailable."}</p> : linkedProduct ? (purchasable ? null : <p class="product-detail__notice" data-not-purchasable>{checkoutAvailable ? "This product can't be bought right now." : "Checkout is unavailable right now, so this product can't be bought."}</p>) : item.availabilitySource === "preview" || !demonstrations ? <p class="product-detail__notice">This is an editorial preview. It is not purchasable.</p> : <p class="product-detail__notice">Availability is shown for this local integration proof. Purchasing is not available here.</p>}
          </div>
        </article>
        {details && <section id="product-details" tabindex="-1" class="product-details" data-product-details aria-label="Product details"><Blocks value={details} components={productDetailComponents} fallback={UnknownBlock} /></section>}
        {linkedProduct && !lookupUnavailable && Astro.response.status === 200 && <RelatedGear productId={linkedProduct.id}
          entries={products.entries} categories={categoryEntries.entries} checkoutAvailable={checkoutAvailable} />}
      </>) : <MissingPageContent title="Product not found" description="This product is not published or does not exist. Search the store or browse the current gear below." />}
    </main>
    <StoreFooter profile={profile} />
  </body>
</html>
<script>
  // Variant pickers: match the picked values to one Commerce member, then show
  // its price and availability and point the single Add to cart at it.
  import { variantPickerView, NO_OFFER_JSON_LD_KEY, type VariantPickerMember } from "../../features/store-shell/variant-picker.ts";
  import { productSelectionUrl } from "../../features/store-shell/product-selection.ts";
  const productJsonLd = document.querySelector<HTMLScriptElement>("[data-product-jsonld]");
  const variantJsonLdData = document.querySelector<HTMLScriptElement>("[data-variant-product-jsonld]");
  const variantJsonLd = JSON.parse(variantJsonLdData?.textContent ?? "{}") as Record<string, unknown>;
  const members = JSON.parse(document.querySelector("[data-variant-members]")?.textContent ?? "[]") as VariantPickerMember[];
  const choices = [...document.querySelectorAll<HTMLInputElement>("[data-variant-choice]")];
  function update(): void {
    const view = variantPickerView(members, Object.fromEntries(
      choices.filter((input) => input.checked).map((input) => [input.dataset.variantOption ?? "", input.value]),
    ));
    for (const input of choices) {
      input.dataset.variantSoldOut = String(view.soldOut[input.dataset.variantOption ?? ""]?.[input.value] ?? true);
    }
    // Copy/reload keeps this selection; no navigation, history entry or cart mutation.
    try { history.replaceState(history.state, "", productSelectionUrl(location.href, view.member?.id ?? null)); } catch {}
    const selectionNotice = document.querySelector<HTMLElement>("[data-product-selection-notice]");
    if (selectionNotice) selectionNotice.hidden = true;
    const priceRow = document.querySelector<HTMLElement>("[data-product-price]");
    const price = document.querySelector("[data-variant-price]");
    if (priceRow) priceRow.hidden = view.price === null;
    if (price && view.price !== null) price.textContent = view.price;
    const sku = document.querySelector<HTMLElement>("[data-product-sku]");
    if (sku) {
      const selectedSku = view.member?.sku ?? "";
      sku.hidden = !selectedSku;
      sku.dataset.productSku = selectedSku;
      sku.textContent = selectedSku ? `SKU ${selectedSku}` : "";
    }
    const status = document.querySelector("[data-product-status]");
    if (status) {
      status.textContent = view.status;
      status.setAttribute("data-availability-status", view.availability);
    }
    const jsonLdKey = view.member?.id ?? NO_OFFER_JSON_LD_KEY;
    if (productJsonLd && Object.hasOwn(variantJsonLd, jsonLdKey)) {
      productJsonLd.textContent = JSON.stringify(variantJsonLd[jsonLdKey]);
    }
    const add = document.querySelector<HTMLElement>("[data-add-to-cart]");
    if (add) {
      if (view.member) add.dataset.addToCart = view.member.id;
      add.dataset.addToCartSellable = String(view.sellable);
      if (add instanceof HTMLButtonElement) add.disabled = !view.sellable;
      add.textContent = view.buttonLabel;
    }
    // The earlier Add belongs to the previous selection; keep actionable persistence alerts.
    const addStatus = document.querySelector<HTMLElement>("[data-add-to-cart-status]");
    if (addStatus?.getAttribute("role") === "status") {
      addStatus.hidden = true;
      addStatus.textContent = "";
      const viewCart = document.querySelector<HTMLElement>("[data-add-to-cart-view]");
      if (viewCart) viewCart.hidden = true;
    }
  }
  for (const input of choices) input.addEventListener("change", update);
  for (const picker of document.querySelectorAll<HTMLElement>("[data-product-variants]")) {
    picker.dataset.variantPickerReady = "1";
  }
</script>
<style>
  .product-page > :global(.missing-page){padding-top:0}
  .product-page{width:min(70rem,calc(100% - 2rem));margin:0 auto;min-height:65vh}
  .browse-breadcrumb{display:flex;flex-wrap:wrap;gap:.7rem;padding:2rem 0;color:var(--store-muted)}
  .browse-breadcrumb a{color:inherit;text-underline-offset:.2em}
  .product-detail{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:clamp(1.5rem,5vw,5rem);align-items:center;margin:1rem 0 5rem}
  /* The frame also sits inside ProductGallery, which this page's scope does not reach. */
  .product-detail :global(.product-detail__visual){min-width:0;aspect-ratio:4/3;overflow:hidden;border:1.5px solid var(--store-ink-border);border-radius:var(--store-radius-card);background:#e9e8df;box-shadow:4px 4px 0 var(--store-shadow)}
  .product-detail :global(.product-detail__visual--hoodie){background:#dce2df}.product-detail :global(.product-detail__visual--cap){background:#e6ddd1}.product-detail :global(.product-detail__visual--beanie){background:#e2e1d6}
  .product-detail :global(.product-detail__visual img){display:block;width:100%;height:100%;object-fit:cover}
  .product-detail__body{min-width:0;overflow-wrap:anywhere}
  h1{font-size:clamp(2.5rem,6vw,5.5rem);line-height:1;letter-spacing:-.05em;margin:.4rem 0 1.5rem}
  .product-detail__description{font-size:clamp(1.05rem,2vw,1.3rem);line-height:1.6}
  .product-detail__summary{font-size:clamp(1.05rem,2vw,1.2rem);line-height:1.6}
  .product-detail__summary :global(a){color:inherit;text-underline-offset:.2em}
  .product-detail__no-image{display:grid;place-items:center;height:100%;margin:0;color:var(--store-muted);letter-spacing:.04em}
  .product-details{display:grid;gap:1rem;max-width:48rem;margin:-2rem 0 5rem}
  .product-details :global(.product-section){border:1.5px solid var(--store-ink-border);border-radius:var(--store-radius-card);background:var(--store-surface);padding:0 1.2rem}
  .product-details :global(.product-section summary){padding:1rem 0;font-weight:800;font-size:1.15rem;cursor:pointer}
  .product-details :global(.product-section__body){padding-bottom:1rem;line-height:1.6}
  .product-details :global(.product-specs h2){font-size:1.15rem;margin:0 0 .5rem}
  .product-details :global(.product-specs dl){display:grid;margin:0;border-top:1px solid var(--store-line)}
