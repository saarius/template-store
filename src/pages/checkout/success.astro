---
import StoreFooter from "../../features/store-shell/StoreFooter.astro";
import StoreHeader from "../../features/store-shell/StoreHeader.astro";
import ThemeHead from "../../features/store-shell/ThemeHead.astro";
import { getSiteSettings } from "emdash";
import { GuestCheckoutReturn } from "../../features/guest-cart/ui.ts";
import { STORE_TITLE, readStorefrontProfile } from "../../features/store-shell/index.js";
import { isCheckoutEnabled, SANDBOX_SESSION_NOTICE, showsSandboxCheckoutNotice } from "../../features/playground-checkout/index.js";
import { isDemoCatalogProfile } from "../../features/playground/demo-products.js";
import "../../features/store-shell/global.css";
import "../../features/guest-cart/receipt-print.css";
import "../../features/guest-cart/receipt-screen.css";

const profile = readStorefrontProfile();
const settings = await getSiteSettings().catch(() => ({}));
const rawSettings = settings as typeof settings & {
  contactEmail?: unknown;
  contactUrl?: unknown;
};
const contactHref = (() => {
  if (typeof rawSettings.contactEmail === "string" && rawSettings.contactEmail.includes("@")) {
    return `mailto:${rawSettings.contactEmail}`;
  }
  if (typeof rawSettings.contactUrl === "string") {
    try {
      const url = new URL(rawSettings.contactUrl);
      if (url.protocol === "https:" || url.protocol === "http:") return url.href;
    } catch {}
  }
  return undefined;
})();
Astro.response.headers.set("Cache-Control", "no-store");
const isPlayground = Boolean((Astro.locals as { __playgroundDb?: unknown }).__playgroundDb);
const sandboxCheckout = showsSandboxCheckoutNotice({ profile, isPlayground, isDemo: isDemoCatalogProfile(), checkoutEnabled: isCheckoutEnabled() });
// Sandbox returns use the same capability-scoped controller as every store:
// only Commerce's durable paid order confirms, and only then is the purchased
// cart settled. No Stripe session id from the URL is looked up or trusted.
---
<!doctype html>
<html lang="en">
  <head>
    <ThemeHead />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Order confirmation | {STORE_TITLE}</title>
  </head>
  <body data-storefront-profile={profile} data-receipt-page>
    <div class="store-demo-banner" data-store-demo-banner role="status">DEMO / TEST STORE — No real charges or shipments. <a href="/test-store">How to try it</a></div>
    <StoreHeader profile={profile} />
    <main id="main-content">
      <div class="receipt-print-only receipt-print-header">
        <p>{STORE_TITLE} · backroadbum.com</p>
        <p>Demo / test store — no real charges or physical shipments.</p>
      </div>
      {sandboxCheckout && <p class="store-sandbox-notice" role="note" data-sandbox-checkout-return>Test mode checkout. {SANDBOX_SESSION_NOTICE}</p>}
      <GuestCheckoutReturn contactHref={contactHref} />
    </main>
    <StoreFooter profile={profile} />
  </body>
</html>

<style>
  .store-sandbox-notice{width:min(70rem,calc(100% - 2rem));margin:1.5rem auto 0;padding:.9rem 1rem;border:1px solid var(--store-line);border-radius:.65rem;background:var(--store-surface);line-height:1.5}
</style>
